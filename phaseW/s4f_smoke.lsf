#!/usr/bin/env bash
#BSUB -J sd-W-s4f-smoke
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 1:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000]"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-s4f-smoke-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-s4f-smoke-%J.err
# S4f gate: the latent-scorer arms run through the frozen S4f trainer on the latent-scored cache.
#   A  CD_dinop_hard on the latent cache (must reproduce the S4 argmax selection map: dbd0d57b...)
#   B  CD_latent_hard  (must run; prints its selection map, which must differ from A's)
#   C  CD_latent_full T=0.04 (must run with finite losses)
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=disabled
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token
J=${LSB_JOBID:-manual}
run() {  # name variant
  local name=$1 variant=$2
  local err="logs/s4f_smoke_${name}_${J}.err" out="logs/s4f_smoke_${name}_${J}.out"
  echo "[$(date --iso-8601=seconds)] run $name: $variant"
  python3 phaseW/train_pilot_frozen_s4f.py --variant "$variant" --coupling fresh --distill_loss x0_huber \
    --seed 0 --sel_seed 0 --selection_dir phaseN/coco_selection_dinopatch_latent --alpha 1.0 --temp 0.04 \
    --N 4 --K 8 --cfg 7.0 --student_cfg 0.0 --cfg_mode composed --num_steps 20 --num_warmup_steps 5 --lr 1e-5 \
    --weight_decay 0.0 --grad_clip 1.0 --height 512 --sched_shift 3.0 --num_train_ts 1000.0 --delta_min 1 --delta_max 3 \
    --scoring_window 0.4,0.9 --support_m 1 --assign_seed 982451653 --huber_c 0.0 --gradient_checkpointing \
    --save_every 1000 --log_every 1 --sample_every 0 --no_wandb \
    --output_dir "checkpoints/phaseW_smoke/s4f_${name}_${J}" > "$out" 2> "$err"
  echo "[$name] losses: $(tr '\r' '\n' < "$err" | grep -oE 'loss=[0-9.e+-]+' | sed 's/loss=//' | awk 'NR%2==1' | tr '\n' ' ')"
  echo "[$name] map: $(grep -oE 'target_map_sha256=[0-9a-f]{16}' "$out" | head -1)"
  rm -rf "checkpoints/phaseW_smoke/s4f_${name}_${J}"
}
run A CD_dinop_hard
run B CD_latent_hard
run C CD_latent_full
python3 - "$J" <<'EOF'
import re, sys, math
J = sys.argv[1]
def losses(n): return [float(x) for x in re.findall(r"loss=([0-9.e+-]+)", open(f"logs/s4f_smoke_{n}_{J}.err").read().replace("\r", "\n"))][::2]
def maph(n):
    m = re.search(r"target_map_sha256=([0-9a-f]{16})", open(f"logs/s4f_smoke_{n}_{J}.out").read()); return m.group(1) if m else None
a, b, c = losses("A"), losses("B"), losses("C")
assert min(len(a), len(b), len(c)) >= 15 and all(math.isfinite(x) for x in a + b + c), "runs incomplete or non-finite"
assert maph("A") == "dbd0d57b2630f5c1", f"dinop map on the latent cache is {maph('A')}, expected dbd0d57b2630f5c1 (records changed?)"
assert maph("B") and maph("B") != maph("A"), "latent map missing or identical to the RGB map"
print(f"[gate] maps: dinop {maph('A')} latent {maph('B')}; mean losses dinop {sum(a)/len(a):.4g} latent-hard {sum(b)/len(b):.4g} latent-full {sum(c)/len(c):.4g}")
print("S4F_SMOKE_OK")
EOF
