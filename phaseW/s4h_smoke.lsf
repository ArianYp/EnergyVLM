#!/usr/bin/env bash
#BSUB -J sd-W-s4h-smoke
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 1:30
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>160000]"
#BSUB -R "rusage[mem=160000]"
#BSUB -M 160000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-s4h-smoke-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-s4h-smoke-%J.err
# S4h gate: the EXACT (decode + DINO) reward.
#   A  argmax, no reward, 20 updates                -> step time and peak memory reference
#   B  argmax + rgb reward lambda=1, probe on 8 updates, monitor every 5 -> verification of the
#      differentiable path vs the PIL scorer, ||grad CD|| vs ||grad reward||, their cosine, step
#      time, peak memory. Prints the lambda for a 20% gradient ratio.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=disabled
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token
J=${LSB_JOBID:-manual}
run() {
  local name=$1; shift
  local err="logs/s4h_smoke_${name}_${J}.err" out="logs/s4h_smoke_${name}_${J}.out"
  echo "[$(date --iso-8601=seconds)] run $name: $*"
  local t0=$(date +%s)
  python3 phaseW/train_pilot_frozen_s4h.py --variant CD_dinop_hard --coupling fresh --distill_loss x0_huber \
    --seed 0 --sel_seed 0 --selection_dir phaseN/coco_selection_dinopatch --alpha 1.0 --temp 1.0 \
    --N 4 --K 8 --cfg 7.0 --student_cfg 0.0 --cfg_mode composed --num_steps 20 --num_warmup_steps 5 --lr 1e-5 \
    --weight_decay 0.0 --grad_clip 1.0 --height 512 --sched_shift 3.0 --num_train_ts 1000.0 --delta_min 1 --delta_max 3 \
    --scoring_window 0.4,0.9 --support_m 1 --assign_seed 982451653 --huber_c 0.0 --gradient_checkpointing \
    --save_every 1000 --log_every 1 --sample_every 0 --no_wandb "$@" \
    --output_dir "checkpoints/phaseW_smoke/s4h_${name}_${J}" > "$out" 2> "$err"
  echo "[$name] wall $(( $(date +%s) - t0 ))s; losses: $(tr '\r' '\n' < "$err" | grep -oE 'loss=[0-9.e+-]+' | sed 's/loss=//' | awk 'NR%2==1' | tr '\n' ' ')"
  echo "[$name] rate: $(tr '\r' '\n' < "$err" | grep -oE '[0-9.]+(s/it|it/s)' | tail -1)"
  grep -E "^\[reward" "$out" | head -14 || true
  rm -rf "checkpoints/phaseW_smoke/s4h_${name}_${J}"
}
run A --reward_monitor_every 0
run B --reward_mode rgb --reward_lambda 1.0 --reward_grad_probe 8 --reward_monitor_every 5
python3 - "$J" <<'EOF'
import re, sys, statistics
J = sys.argv[1]
b = open(f"logs/s4h_smoke_B_{J}.out").read()
ver = re.search(r"differentiable vs PIL scorer on \d+ teacher latents: max\|diff\| ([0-9.]+) mean\|diff\| ([0-9.]+) corr ([0-9.]+)", b)
assert ver, "no verification line"
mx, mn, corr = (float(v) for v in ver.groups())
print(f"[gate] differentiable vs PIL DINO score: max|diff| {mx:.4f} mean|diff| {mn:.5f} corr {corr:.4f}")
assert mx < 0.03 and corr > 0.98, "differentiable path disagrees with the offline scorer"
probes = re.findall(r"\|\|grad CD\|\|=([0-9.]+) \|\|grad reward\|\|=([0-9.]+) ratio=([0-9.]+) cos\(CD,reward\)=([0-9.-]+) r=([0-9.-]+)", b)
assert len(probes) >= 6, f"only {len(probes)} probes"
med = statistics.median(float(p[2]) for p in probes)
print(f"[gate] probes {len(probes)}: ||grad CD|| median {statistics.median(float(p[0]) for p in probes):.1f}, ||grad reward|| median {statistics.median(float(p[1]) for p in probes):.4f} at lambda=1, "
      f"ratio median {med:.5f}, cos(CD,reward) median {statistics.median(float(p[3]) for p in probes):.3f}, r median {statistics.median(float(p[4]) for p in probes):.3f}")
print(f"[gate] LAMBDA_20PCT={0.2 / med:.3f}")
assert "Traceback" not in open(f"logs/s4h_smoke_B_{J}.err").read(), "rgb reward run failed"
print("S4H_SMOKE_OK")
EOF
