#!/usr/bin/env bash
#BSUB -J sd-eval10-fix
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 6:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>96000]"
#BSUB -R "rusage[mem=96000]"
#BSUB -M 96000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=40G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-eval10-fix-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-eval10-fix-%J.err
# Finish the CompBench 'complex' category of the official-10 run 136962 (killed by the 16 h limit in the
# GenEval2 stage; the BLIP annotation of 'complex' was in progress) and write alignment.json with the
# CompBench mean over the 8 categories. GenEval2 is not re-run (marked partial).
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
source ~/.secrets/hf_token
ROOT=phaseN/eval10_S4_CD_dinop_hard-avglast3_s1_136962
LABEL=S4_CD_dinop_hard-avglast3_s1
D="$ROOT/compbench_scores/${LABEL}_s4_complex"
python3 phaseC/compbench_eval.py run --dir "$D" --skip_done
python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split val
test -s "$D/scores.json"
python3 - <<PY
import json, glob, numpy as np
root = "$ROOT"; cats = {}
for p in sorted(glob.glob(f"{root}/compbench_scores/*/scores.json")):
    cat = p.split("/")[-2].split("_s4_", 1)[1]; cats[cat] = float(np.mean([float(r["score"]) for r in json.load(open(p))["per_prompt"]]))
assert len(cats) == 8, cats
out = {"label": "$LABEL", "compbench": cats, "compbench_mean": sum(cats.values()) / len(cats), "geneval2": None,
       "partial": "GenEval2 stage not run (job 136962 hit the 16 h run limit); CompBench complete, 'complex' finished by this job"}
json.dump(out, open(f"{root}/alignment.json", "w"), indent=1); print("compbench_mean", out["compbench_mean"], cats)
PY
echo EVAL10_FIX_DONE
