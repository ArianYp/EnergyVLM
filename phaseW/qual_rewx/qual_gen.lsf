#!/usr/bin/env bash
#BSUB -J sd-W-qual-rewx
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 3:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000]"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=40G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-qual-rewx-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-qual-rewx-%J.err
# All columns of the exact-reward qualitative figure on the selected prompts only: base model at
# 4 and 28 steps without / with guidance, and the three averaged seed-0 students (random pick,
# argmax, argmax + exact reward) at 4 steps without guidance. The subset JSONs keep each prompt's
# ORIGINAL pool index and phaseA_generate seeds with `--seed + idx`, so every column of a row
# shares initial noise (the students' eval images were deleted in the cleanup; regenerated here).
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
source ~/.secrets/hf_token
ROOT=${ROOT:-phaseW/qual_rewx}
declare -A CK=( [RANDOM]=checkpoints/phaseS4/phaseS4_B2_s0_130449/checkpoint_avg_last5.pt
                [ARGMAX]=checkpoints/phaseS4/phaseS4_CD_dinop_hard_s0_130455/checkpoint_avg_last5.pt
                [REWARD]=checkpoints/phaseS4/phaseS4_CD_dinop_hard-rewX_s0_136368/checkpoint_avg_last5.pt )
for B in compbench geneval2; do
  for CFG in 1.0 7.0; do
    TAG=$(echo "$CFG" | cut -d. -f1)
    python3 exp0/phaseA_generate.py --out_root "$ROOT/gen_${B}" --label "BASE_cfg${TAG}" --checkpoint base \
      --cfg "$CFG" --prompts_json "$ROOT/${B}_subset.json" --steps_list 4,28
  done
  for L in RANDOM ARGMAX REWARD; do
    python3 exp0/phaseA_generate.py --out_root "$ROOT/gen_${B}" --label "$L" --checkpoint "${CK[$L]}" \
      --cfg 1.0 --prompts_json "$ROOT/${B}_subset.json" --steps_list 4
  done
done
for B in compbench geneval2; do
  python3 phaseW/qual_rewx/build_figure.py --bench $B --root "$ROOT" --out "$ROOT/fig_${B}.png"
done
echo "[$(date --iso-8601=seconds)] QUAL_REWX_DONE"
