#!/usr/bin/env bash
#BSUB -J sd-W-equiv-s4i
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 3:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>160000]"
#BSUB -R "rusage[mem=160000]"
#BSUB -M 160000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-equiv-s4i-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-equiv-s4i-%J.err
# Fifth equivalence round: the RNG-restored reward trainer (S4i, the factorial's trainer) against the
# release trainer, 6 updates, deterministic kernels. Pairs: argmax + exact reward, random + exact
# reward (the missing factorial cell), and the zero-weight control on the release side (reward mode
# with lambda 0 must be bit-identical to no reward).
set -uo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=disabled
export CUBLAS_WORKSPACE_CONFIG=:4096:8
source ~/.secrets/hf_token
REPO=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
DET=$REPO/phaseW/_equiv/det
OUT=$REPO/phaseW/_equiv/out_s4i
rm -rf "$OUT"; mkdir -p "$OUT"
CLEAN=$OUT/clean-snapshot
rsync -a --exclude .git "$REPO/phaseW/_equiv/clean-tree/" "$CLEAN/"
grep -q 'reward_legacy_rng' "$CLEAN/train/distill.py" || { echo "snapshot lacks the RNG-restore code"; exit 1; }
CACHE=$REPO/phaseN/coco_selection_dinopatch
REF=$REPO/phaseW/latent_scorer/ref_emb_3k.pt
REPLAY=$REPO/phaseW/latent_scorer/replay_2k.pt
STEPS=6
COMMON_ORIG="--coupling fresh --distill_loss x0_huber --seed 0 --sel_seed 0 --selection_dir $CACHE \
  --alpha 1.0 --N 4 --K 8 --cfg 7.0 --student_cfg 0.0 --cfg_mode composed \
  --num_warmup_steps 300 --lr 1e-5 --weight_decay 0.0 --grad_clip 1.0 --height 512 \
  --sched_shift 3.0 --num_train_ts 1000.0 --delta_min 1 --delta_max 3 --scoring_window 0.4,0.9 \
  --support_m 1 --assign_seed 982451653 --huber_c 0.0 --gradient_checkpointing --save_every 100000 \
  --log_every 1 --sample_every 0 --no_wandb --num_steps $STEPS --temp 1.0 \
  --reward_ref $REF --reward_replay $REPLAY --reward_monitor_every 3"
COMMON_NEW="--cache_dir $CACHE --seed 0 --sel_seed 0 --num_warmup_steps 300 --lr 1e-5 --K 8 --cfg 7.0 \
  --window 0.4,0.9 --delta_min 1 --delta_max 3 --height 512 --gradient_checkpointing --save_every 100000 --log_every 1 --num_steps $STEPS \
  --reward_ref $REF --reward_replay $REPLAY --reward_monitor_every 3"
echo "orig trainer sha s4i $(sha256sum $REPO/phaseW/train_pilot_frozen_s4i.py | cut -c1-8); release trainer sha $(sha256sum $CLEAN/train/distill.py | cut -c1-8); release commit $(git -C $REPO/phaseW/_equiv/clean-tree rev-parse --short HEAD)"
run () { local out="$OUT/$1"; shift; local t0=$(date +%s); ( "$@" --output_dir "$out" ) > "$out.log" 2>&1; echo "$(basename "$out") rc=$? $(( $(date +%s) - t0 ))s losses: $(tr '\r' '\n' < "$out.log" | grep -oE 'loss=[0-9.e+-]+' | sed 's/loss=//' | awk 'NR%2==1' | tr '\n' ' ')"; }
cd "$REPO"
O="env PYTHONPATH=$DET:$REPO python3 phaseW/train_pilot_frozen_s4i.py"
run orig_argX_a $O --variant CD_dinop_hard $COMMON_ORIG --reward_mode rgb --reward_lambda 15.504
run orig_argX_b $O --variant CD_dinop_hard $COMMON_ORIG --reward_mode rgb --reward_lambda 15.504
run orig_rndX   $O --variant B2            $COMMON_ORIG --reward_mode rgb --reward_lambda 15.504
run orig_arg0   $O --variant CD_dinop_hard $COMMON_ORIG --reward_monitor_every 0
cd "$CLEAN"
N="env PYTHONPATH=$DET:$CLEAN python3 train/distill.py"
run new_argX  $N --selector dino_patch $COMMON_NEW --reward_mode rgb --reward_lambda 15.504
run new_rndX  $N --selector random     $COMMON_NEW --reward_mode rgb --reward_lambda 15.504
run new_arg0  $N --selector dino_patch $COMMON_NEW --reward_mode rgb --reward_lambda 0 --reward_monitor_every 0
run new_none  $N --selector dino_patch $COMMON_NEW --reward_monitor_every 0
cd "$REPO"
OUT="$OUT" python3 - <<'PY'
import os, torch
OUT = os.environ["OUT"]
def sd(p): return torch.load(f"{OUT}/{p}/checkpoint_final.pt", map_location="cpu", weights_only=False, mmap=True)["model"]
def cmp(a, b, label):
    A, B = sd(a), sd(b)
    mx = max(float((A[k].float() - B[k].float()).abs().max()) for k in A); same = sum(int(torch.equal(A[k], B[k])) for k in A)
    print(f"{label:62s}: {same}/{len(A)} tensors identical, max|diff|={mx:.3e}"); return mx
c = cmp("orig_argX_a", "orig_argX_b", "control: orig vs orig (argmax + exact reward)")
z1 = cmp("orig_arg0", "new_none", "orig no-reward vs release no-reward (must be bit-exact)")
z2 = cmp("new_arg0", "new_none", "release zero-weight control vs release no-reward (must be bit-exact)")
dX = cmp("orig_argX_a", "new_argX", "orig vs release: argmax + exact reward")
dR = cmp("orig_rndX", "new_rndX", "orig vs release: random + exact reward")
diff = cmp("orig_rndX", "orig_argX_a", "sanity: random+reward vs argmax+reward (must differ)")
ok = z1 == 0.0 and z2 == 0.0 and dX <= 2 * c and dR <= 2 * c and diff > 0
print("EQUIV_S4I_RESULT", "PASS" if ok else "FAIL", f"(control {c:.1e}; pairs {dX:.1e} / {dR:.1e}; zero-weight {z1:.1e} / {z2:.1e})")
PY
