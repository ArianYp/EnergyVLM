#!/usr/bin/env bash
#BSUB -J sd-W-equiv-s4b
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 4:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000]"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-equiv-s4b-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-equiv-s4b-%J.err
# Release trainer (phaseW/_equiv/clean-tree/train/distill.py) against the experimental trainer
# (phaseC/train_pilot.py, the code every reported run used through its frozen copies), under
# deterministic kernels, for every selector and the accumulation path used in the report.
# Each pair must be bit-identical on all parameter tensors after 6 optimizer updates; the
# original-vs-original control must be exactly 0.0 (proves the kernels are deterministic here).
set -uo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=disabled
export CUBLAS_WORKSPACE_CONFIG=:4096:8
source ~/.secrets/hf_token
REPO=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
DET=$REPO/phaseW/_equiv/det
CLEAN=$REPO/phaseW/_equiv/clean-tree
OUT=$REPO/phaseW/_equiv/out_s4b
rm -rf "$OUT"; mkdir -p "$OUT"
CACHE=$REPO/phaseN/coco_selection_dinopatch
STEPS=6
COMMON_ORIG="--coupling fresh --distill_loss x0_huber --seed 0 --sel_seed 0 --selection_dir $CACHE \
  --alpha 1.0 --N 4 --K 8 --cfg 7.0 --student_cfg 0.0 --cfg_mode composed \
  --num_warmup_steps 300 --lr 1e-5 --weight_decay 0.0 --grad_clip 1.0 --height 512 \
  --sched_shift 3.0 --num_train_ts 1000.0 --delta_min 1 --delta_max 3 --scoring_window 0.4,0.9 \
  --support_m 1 --assign_seed 982451653 --huber_c 0.0 --gradient_checkpointing --save_every 100000 \
  --log_every 1 --sample_every 0 --no_wandb"
COMMON_NEW="--cache_dir $CACHE --seed 0 --sel_seed 0 --num_warmup_steps 300 --lr 1e-5 --K 8 --cfg 7.0 \
  --window 0.4,0.9 --delta_min 1 --delta_max 3 --height 512 --gradient_checkpointing --save_every 100000 --log_every 1"
echo "orig trainer sha $(sha256sum $REPO/phaseC/train_pilot.py | cut -c1-8); release trainer sha $(sha256sum $CLEAN/train/distill.py | cut -c1-8); release commit $(git -C $CLEAN rev-parse --short HEAD)"

run () {  # $1 label, rest = command
  local out="$OUT/$1"; shift
  local t0=$(date +%s)
  ( "$@" --output_dir "$out" ) > "$out.log" 2>&1
  echo "$(basename "$out") rc=$? $(( $(date +%s) - t0 ))s losses: $(tr '\r' '\n' < "$out.log" | grep -oE 'loss=[0-9.e+-]+' | sed 's/loss=//' | awk 'NR%2==1' | tr '\n' ' ')"
}
cd "$REPO"
O="env PYTHONPATH=$DET:$REPO python3 phaseC/train_pilot.py"
run orig_dino_a    $O --variant CD_dinop_hard   --temp 1.0  --num_steps $STEPS $COMMON_ORIG
run orig_dino_b    $O --variant CD_dinop_hard   --temp 1.0  --num_steps $STEPS $COMMON_ORIG
run orig_random    $O --variant B2              --temp 1.0  --num_steps $STEPS $COMMON_ORIG
run orig_full      $O --variant CD_dinop_full   --temp 0.04 --num_steps $STEPS $COMMON_ORIG
run orig_cat       $O --variant CD_dinop_cat    --temp 0.04 --num_steps $STEPS $COMMON_ORIG
run orig_uvisit    $O --variant CD_uniform_visit --temp 1.0 --num_steps $STEPS $COMMON_ORIG
run orig_accum     $O --variant CD_dinop_hard   --temp 1.0  --num_steps 3 --accum 2 $COMMON_ORIG
cd "$CLEAN"
N="env PYTHONPATH=$DET:$CLEAN python3 train/distill.py"
run new_dino       $N --selector dino_patch       --num_steps $STEPS $COMMON_NEW
run new_random     $N --selector random           --num_steps $STEPS $COMMON_NEW
run new_full       $N --selector boltzmann        --temp 0.04 --num_steps $STEPS $COMMON_NEW
run new_cat        $N --selector boltzmann_sample --temp 0.04 --num_steps $STEPS $COMMON_NEW
run new_uvisit     $N --selector uniform_visit    --num_steps $STEPS $COMMON_NEW
run new_accum      $N --selector dino_patch       --num_steps 3 --accum 2 $COMMON_NEW
cd "$REPO"
echo "=== selection hashes ==="; grep -h "sha256" "$OUT"/*.log | cut -c1-140

OUT="$OUT" python3 - <<'PY'
import os, torch
OUT = os.environ["OUT"]
def sd(p): return torch.load(p, map_location="cpu", weights_only=False)["model"]
def cmp(a, b, label):
    A, B = sd(f"{OUT}/{a}/checkpoint_final.pt"), sd(f"{OUT}/{b}/checkpoint_final.pt")
    assert set(A) == set(B), "key sets differ"
    mx = max(float((A[k].float() - B[k].float()).abs().max()) for k in A)
    same = sum(int(torch.equal(A[k], B[k])) for k in A)
    print(f"{label:52s}: {same}/{len(A)} tensors identical, max|diff|={mx:.3e}")
    return mx
ok = cmp("orig_dino_a", "orig_dino_b", "control: orig vs orig (dino_patch)") == 0.0
different = cmp("orig_dino_a", "orig_random", "sanity: dino_patch vs random (must differ)") > 0.0
for a, b, lab in (("orig_dino_a", "new_dino", "dino_patch"), ("orig_random", "new_random", "random"),
                  ("orig_full", "new_full", "boltzmann (exact, T=0.04)"), ("orig_cat", "new_cat", "boltzmann_sample (T=0.04)"),
                  ("orig_uvisit", "new_uvisit", "uniform_visit"), ("orig_accum", "new_accum", "dino_patch + accum 2")):
    ok &= cmp(a, b, f"orig vs release: {lab}") == 0.0
print("EQUIV_S4B_RESULT", "PASS" if (ok and different) else "FAIL")
PY
