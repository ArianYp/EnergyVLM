#!/usr/bin/env bash
#BSUB -J sd-W-s4j-smoke
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 1:30
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>160000]"
#BSUB -R "rusage[mem=160000]"
#BSUB -M 160000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-s4j-smoke-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-s4j-smoke-%J.err
# S4j gate (deterministic kernels, 6 updates each). A: s4i (the factorial trainer) argmax + rgb reward.
# B: s4j with default flags -> must equal A within the rgb path's own nondeterminism (< 2e-6, losses
# identical to 3 s.f.). C-G: each ablation flag runs and prints its verification line.
set -uo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=disabled
export CUBLAS_WORKSPACE_CONFIG=:4096:8
source ~/.secrets/hf_token
REPO=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
DET=$REPO/phaseW/_equiv/det
OUT=$REPO/checkpoints/phaseW_smoke/s4j_${LSB_JOBID:-manual}
rm -rf "$OUT"; mkdir -p "$OUT"
COMMON="--coupling fresh --distill_loss x0_huber --seed 0 --sel_seed 0 --selection_dir phaseN/coco_selection_dinopatch \
  --alpha 1.0 --N 4 --K 8 --cfg 7.0 --student_cfg 0.0 --cfg_mode composed --num_warmup_steps 300 --lr 1e-5 \
  --weight_decay 0.0 --grad_clip 1.0 --height 512 --sched_shift 3.0 --num_train_ts 1000.0 --delta_min 1 --delta_max 3 \
  --scoring_window 0.4,0.9 --support_m 1 --assign_seed 982451653 --huber_c 0.0 --gradient_checkpointing --save_every 100000 \
  --log_every 1 --sample_every 0 --no_wandb --num_steps 6 --temp 1.0 --variant CD_dinop_hard --reward_monitor_every 3"
run () { local out="$OUT/$1"; shift; local t0=$(date +%s); ( "$@" --output_dir "$out" ) > "$out.log" 2>&1; echo "$(basename "$out") rc=$? $(( $(date +%s) - t0 ))s losses: $(tr '\r' '\n' < "$out.log" | grep -oE 'loss=[0-9.e+-]+' | sed 's/loss=//' | awk 'NR%2==1' | tr '\n' ' ')"; grep -hE "^\[reward-rgb\]" "$out.log" | sed 's/^/    /' | head -1; }
I="env PYTHONPATH=$DET:$REPO python3 phaseW/train_pilot_frozen_s4i.py"
J="env PYTHONPATH=$DET:$REPO python3 phaseW/train_pilot_frozen_s4j.py"
run A $I $COMMON --reward_mode rgb --reward_lambda 15.504
run B $J $COMMON --reward_mode rgb --reward_lambda 15.504
run C $J $COMMON --reward_mode rgb --reward_lambda 15.504 --reward_states_pick noisiest
run D $J $COMMON --reward_mode rgb --reward_lambda 15.504 --reward_resize bilinear
run E $J $COMMON --reward_mode rgb --reward_lambda 15.504 --reward_dino_dtype bf16
run F $J $COMMON --reward_mode rgb --reward_lambda 15.504 --reward_states 5
run G $J $COMMON --reward_proj phaseW/latent_scorer/projector/projector.pt --reward_lambda 80 --reward_refresh_every 3 --reward_refresh_steps 16
OUT="$OUT" python3 - <<'PY'
import os, torch
OUT = os.environ["OUT"]
def sd(p): return torch.load(f"{OUT}/{p}/checkpoint_final.pt", map_location="cpu", weights_only=False, mmap=True)["model"]
A, B = sd("A"), sd("B")
mx = max(float((A[k].float() - B[k].float()).abs().max()) for k in A)
print(f"s4j defaults vs s4i: max|diff|={mx:.3e} (rgb path nondeterminism ~7e-7)")
ok = mx < 2e-6
for r in "CDEFG":
    ok &= os.path.exists(f"{OUT}/{r}/checkpoint_final.pt") and "Traceback" not in open(f"{OUT}/{r}.log").read()
print("S4J_SMOKE", "PASS" if ok else "FAIL")
PY
rm -rf "$OUT"
