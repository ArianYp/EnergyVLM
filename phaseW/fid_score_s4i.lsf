#!/usr/bin/env bash
#BSUB -J sd-W-fidscore-s4i
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 8:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000]"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=40G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-fidscore-s4i-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-fidscore-s4i-%J.err
# FID / CMMD / precision / recall for the selection-rule arms (raw final checkpoints, 3 seeds):
# random, argmax, Full-4 T=0.04, Cat-1 T=0.04, plus the two gate pools the scorer expects.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token
MODELS=$(ls -d phaseT/fidelity/images/S4_* | xargs -n1 basename | tr '\n' ',')T_B4_s0,T_B2_s0
echo "[$(date --iso-8601=seconds)] scoring pools: $MODELS"
python3 phaseC/fidelity_eval.py \
  --gen_root phaseT/fidelity/images \
  --models "$MODELS" \
  --gate_models T_B4_s0,T_B2_s0 \
  --steps 4 \
  --n_ref 5000 --min_gen 1000 \
  --title "Selection-rule arms (3k pool, raw finals), per seed" \
  --out phaseW/fidelity_s4i_report.md
echo "[$(date --iso-8601=seconds)] done -> phaseW/fidelity_s4i_report.md"
