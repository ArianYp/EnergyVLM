# Wider search: 13 more CompBench 2D-spatial prompts (left/right/top/bottom), student (4 steps) vs
# frozen teacher (28 steps, CFG 7), to find genuine visible placement errors for the paper figure.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
source ~/.secrets/hf_token
ROOT=phaseW/qual_paper
CK=checkpoints/phaseS4/phaseS4_CD_dinop_hard-rewXi_s0_136980/checkpoint_avg_last5.pt
python3 exp0/phaseA_generate.py --out_root "$ROOT/gen2" --label STUDENT --checkpoint "$CK" --cfg 1.0 --prompts_json "$ROOT/subset2.json" --steps_list 4
python3 exp0/phaseA_generate.py --out_root "$ROOT/gen2" --label TEACHER --checkpoint base --cfg 7.0 --prompts_json "$ROOT/subset2.json" --steps_list 28
echo QUAL_PAPER2_DONE
