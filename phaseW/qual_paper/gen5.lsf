# 28-step samples from the projector-reward student (the paper's headline method), 8 diverse prompts,
# to cherry-pick from for a qualitative look at the model.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
source ~/.secrets/hf_token
ROOT=phaseW/qual_paper
CK=checkpoints/phaseS4/phaseS4_CD_dinop_hard-rewRi-s16_s0_137621/checkpoint_avg_last5.pt
python3 exp0/phaseA_generate.py --out_root "$ROOT/gen5" --label STUDENT --checkpoint "$CK" --cfg 1.0 --prompts_json "$ROOT/subset_28step.json" --steps_list 28
echo QUAL_PAPER5_DONE
