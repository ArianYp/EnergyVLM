# Three hand-picked CompBench 2D-spatial prompts (left/right/top placement), the exact-reward
# student (averaged, seed 0) at 4 and 8 steps vs the frozen teacher at 28 steps with CFG=7.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
source ~/.secrets/hf_token
ROOT=phaseW/qual_paper
CK=checkpoints/phaseS4/phaseS4_CD_dinop_hard-rewXi_s0_136980/checkpoint_avg_last5.pt
python3 exp0/phaseA_generate.py --out_root "$ROOT/gen" --label STUDENT --checkpoint "$CK" --cfg 1.0 --prompts_json "$ROOT/subset.json" --steps_list 4,8
python3 exp0/phaseA_generate.py --out_root "$ROOT/gen" --label TEACHER --checkpoint base --cfg 7.0 --prompts_json "$ROOT/subset.json" --steps_list 28
echo QUAL_PAPER_DONE
