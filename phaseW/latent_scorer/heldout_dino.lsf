#!/usr/bin/env bash
#BSUB -J sd-W-heldout
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 3:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>96000]"
#BSUB -R "rusage[mem=96000]"
#BSUB -M 96000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=40G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-heldout-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-heldout-%J.err
# Held-out DINO similarity (supervised clean estimates + complete 4-step samples) for every
# checkpoint of the runs listed in CKPT_LIST (one path per line; label derived from the path).
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token
: "${CKPT_LIST:?}"
mkdir -p phaseW/latent_scorer/heldout
while read ck; do
  [ -z "$ck" ] && continue
  lab=$(echo "$ck" | sed -E 's|checkpoints/phaseS4/phaseS4_||; s|/checkpoint_|@|; s|\.pt$||; s|_[0-9]{6}@|@|')
  python3 phaseW/latent_scorer/heldout_dino.py --ckpt "$ck" --out "phaseW/latent_scorer/heldout/${lab}.json"
done < "$CKPT_LIST"
echo HELDOUT_DONE
