#!/usr/bin/env bash
#BSUB -J distill-3k
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 6:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000]"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -o logs/distill-3k-%J.out
#BSUB -e logs/distill-3k-%J.err
#
# The 3k-caption configuration used for every three-seed result and every ablation in the report:
# one GPU, 6,000 updates (two passes over 3,000 captions), lr 1e-5 with a 300-step linear warm-up
# then constant, gradient clip 1.0, pseudo-Huber x0 loss, window 0.4-0.9, delta in {1,2,3}.
# About 1.6 hours on one H200. Only SELECTOR and SEED differ between arms.
#
#   for S in 0 1 2; do
#     bsub -env "all,SELECTOR=random,SEED=$S"     < scripts/train_3k.lsf
#     bsub -env "all,SELECTOR=dino_patch,SEED=$S" < scripts/train_3k.lsf
#   done
set -euo pipefail
source scripts/env.sh

#
# The selection-rule ablation of the report (all on this configuration, three seeds each):
#   SELECTOR=boltzmann TEMP=0.04|0.08|1e6      exact soft weighting (1e6 = uniform over all four)
#   SELECTOR=boltzmann_sample TEMP=0.04|0.08   one draw per visit from the same weights
#   SELECTOR=uniform_visit                     one uniform draw per visit
#   SELECTOR=boltzmann_frozen TEMP=0.04 MAP_SEED=<n>   one softmax draw per caption, fixed for the run
#   SELECTOR=boltzmann_mc TEMP=0.04 MCD=4      four draws per visit, count-weighted losses
# The boltzmann runs roll out and train on all four candidates (about 3.5 h instead of 1.2 h).
#
# The reward arms (report Sections 11.6 and 11.7), on SELECTOR=dino_patch; inputs from
# data/build_reward_refs.py (REWARD_REF, REWARD_REPLAY) and train/latent_scorer.py (REWARD_PROJ):
#   REWARD_MODE=proj REWARD_LAMBDA=80                        frozen projector reward      (-rewF)
#   REWARD_MODE=proj REWARD_LAMBDA=80 REWARD_REFRESH=100     projector refreshed every 100 (-rewR)
#   REWARD_MODE=proj REWARD_LAMBDA=80 REWARD_REFRESH=100 REWARD_REFRESH_STEPS=16
#                                                            THE PAPER'S ARM ("ours", paper/): the
#                                                            projector refreshed every 100 updates for
#                                                            16 AdamW steps                (-rewR-s16)
#   REWARD_MODE=rgb  REWARD_LAMBDA=15.5                      exact decode + DINOv2 reward (-rewX)
# Every 3k run of the paper's main tables uses this launcher's defaults (constant LR after warm-up).
# The paper's converged schedule at 3k (Section 3.6: cosine decay, batch 16, lr 1e-5, window K={4..7},
# 3,000 updates = 16 passes) needs four GPUs and is launched with scripts/train.lsf, see there.

: "${SELECTOR:?set SELECTOR (random | dino_patch | latent | boltzmann | boltzmann_sample | boltzmann_frozen | boltzmann_mc | uniform_visit)}"
SEED=${SEED:-0}
CACHE=${CACHE:-cache/train_3k}
STEPS=${STEPS:-6000}
LR=${LR:-1e-5}
WARMUP=${WARMUP:-300}
LR_SCHEDULE=${LR_SCHEDULE:-constant}      # constant | cosine (decay to 0 at STEPS)
WINDOW=${WINDOW:-0.4:0.9}                 # supervised window; colon-separated because `bsub -env` splits on commas
TEMP=${TEMP:-0.04}
MAP_SEED=${MAP_SEED:-1000003}
MCD=${MCD:-4}
SCORE_FIELD=${SCORE_FIELD:-dino_patch_cos}
REWARD_MODE=${REWARD_MODE:-none}
REWARD_LAMBDA=${REWARD_LAMBDA:-0}
REWARD_REFRESH=${REWARD_REFRESH:-0}
REWARD_REFRESH_STEPS=${REWARD_REFRESH_STEPS:-4}
REWARD_PROJ=${REWARD_PROJ:-checkpoints/latent_scorer/projector.pt}
REWARD_REF=${REWARD_REF:-cache/reward/ref_emb.pt}
REWARD_REPLAY=${REWARD_REPLAY:-cache/reward/replay.pt}
RUN="${SELECTOR}"
case "$SELECTOR" in boltzmann*) RUN="${RUN}-T${TEMP}"; [ "$SCORE_FIELD" != "dino_patch_cos" ] && RUN="${RUN}-${SCORE_FIELD%_cos}";; esac
case "$REWARD_MODE" in
  proj) if [ "$REWARD_REFRESH" != 0 ]; then RUN="${RUN}-rewR"; [ "$REWARD_REFRESH_STEPS" != 4 ] && RUN="${RUN}-s${REWARD_REFRESH_STEPS}"; else RUN="${RUN}-rewF"; fi;;
  rgb)  RUN="${RUN}-rewX";;
esac
[ "$LR_SCHEDULE" != "constant" ] && RUN="${RUN}-${LR_SCHEDULE}"
RUN="${RUN}_3k_s${SEED}"
mkdir -p checkpoints logs
echo "selector=$SELECTOR seed=$SEED captions=$(cat "$CACHE"/selection_rank*.jsonl | wc -l) gpus=1 steps=$STEPS lr=$LR warmup=$WARMUP schedule=$LR_SCHEDULE window=$WINDOW temp=$TEMP"

torchrun --standalone --nproc-per-node=1 train/distill.py \
  --selector "$SELECTOR" --cache_dir "$CACHE" --output_dir "checkpoints/$RUN" \
  --seed "$SEED" --num_steps "$STEPS" --num_warmup_steps "$WARMUP" --lr "$LR" --lr_schedule "$LR_SCHEDULE" \
  --temp "$TEMP" --map_seed "$MAP_SEED" --mc_draws "$MCD" --score_field "$SCORE_FIELD" \
  --K 8 --cfg 7.0 --window "${WINDOW//:/,}" --delta_min 1 --delta_max 3 --height 512 \
  --gradient_checkpointing --save_every 2000 --log_every 10 \
  --reward_mode "$REWARD_MODE" --reward_lambda "$REWARD_LAMBDA" --reward_refresh_every "$REWARD_REFRESH" --reward_refresh_steps "$REWARD_REFRESH_STEPS" \
  --reward_grad_probe_every "${REWARD_PROBE_EVERY:-500}" \
  --reward_proj "$REWARD_PROJ" --reward_ref "$REWARD_REF" --reward_replay "$REWARD_REPLAY" \
  --sample_every "${SAMPLE_EVERY:-0}" --sample_prompts "${SAMPLE_PROMPTS:-pools/sample_prompts.json}" \
  ${WANDB_PROJECT:+--wandb_project "$WANDB_PROJECT" --wandb_run_name "$RUN"} ${EXTRA:-}
