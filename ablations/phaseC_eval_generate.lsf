#!/usr/bin/env bash
#BSUB -J sd-phaseC-eval-gen
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseC-eval-gen-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseC-eval-gen-%J.err

# Phase C1 eval — generate B2/B4/M1 on the HELD-OUT CompBench-VAL split (disjoint
# from training) at {4,8,28} steps, for the pre-registered independent eval.
# per_category 1000 -> full val (~300/cat, 8 cats = 2398 prompts, train-overlap excluded).
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token
echo "[`date`] Phase C1 eval-gen (val) | Host: $(hostname)"
nvidia-smi --query-gpu=index,name,memory.total --format=csv
for spec in "M1:checkpoints/method/M1_pure_consistency_20260624_065127_55187/checkpoint_final.pt" "B2:checkpoints/phaseC/phaseC_B2_20260724_230657_85487/checkpoint_final.pt" "B4:checkpoints/phaseC/phaseC_B4_20260724_230700_85488/checkpoint_final.pt"; do
  LABEL=${spec%%:*}; CKPT=${spec#*:}
  echo "=== GENERATE $LABEL on val ==="
  torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
    --out_root phaseC/eval --label $LABEL --checkpoint "$CKPT" --cfg 1 \
    --split val --steps_list 4,8,28 --per_category 1000
done
echo "[`date`] DONE -> phaseC/eval/images/{M1,B2,B4}"
if command -v my-job-stats >/dev/null 2>&1; then my-job-stats -a -n -s; fi
