#!/usr/bin/env bash
#BSUB -J sd-phaseC-eval-gen-base
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseC-eval-gen-base-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseC-eval-gen-base-%J.err

# The teacher reference ON THE VAL PROMPTS — a gap the eval had until now.
#
# phaseC_eval_generate.lsf generates B2/B4/M1 only. The pre-registration §1 names the
# 28-step base teacher as the upper-bound reference point and says it was "already
# evaluated in Phase A" — but Phase A ran it on the *train dev pool*, so every
# teacher-relative statement ("M1@4 reaches 97% of teacher@28") is measured on different
# prompts than the primary metric. Without base on val, "what fraction of the
# student-to-teacher gap did B4 close" cannot be answered on the primary metric's own
# prompt set. This job closes that, on exactly the same 2,398 val prompts and the same
# per-prompt seeds, so it joins the paired analysis by idx.
#
# base is sampled WITH CFG 7 at 28 steps, which is its intended operating point and the
# regime the distillation targets were built in; the students run CFG 1 at 4 steps. The
# comparison is therefore a *budget* comparison (what you get per unit compute), not a
# controlled one, and eval_analyze.py prints that caveat next to the numbers. 4 steps is
# generated too, so the same-budget-different-method contrast is available as well.
#
# Deliberately NOT a gate and NOT part of PRIMARY 1 or 2 — H1 is strictly B4 vs B2. This
# is context for the write-up, added after the fact and labelled as such.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token
echo "[`date`] Phase C1 eval-gen-base (val, teacher reference) | Host: $(hostname)"
nvidia-smi --query-gpu=index,name,memory.total --format=csv

torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
  --out_root phaseC/eval --label base --checkpoint base --cfg 7 \
  --split val --steps_list 4,28 --per_category 1000

echo "=== score base on all 8 categories (official evaluators) ==="
python3 phaseC/test_3in1_identity.py

for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
  for S in 4 28; do
    D=phaseC/eval_scores/base_s${S}_${CAT}
    echo "--- base / ${CAT} / ${S} steps ---"
    python3 phaseC/compbench_eval.py stage --images phaseC/eval/images/base \
      --prompts phaseC/eval/prompts.json --steps $S --categories ${CAT} --out "$D"
    python3 phaseC/compbench_eval.py run     --dir "$D" --skip_done
    python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split val
  done
done

echo "[`date`] DONE -> phaseC/eval/images/base + phaseC/eval_scores/base_s{4,28}_*"
if command -v my-job-stats >/dev/null 2>&1; then my-job-stats -a -n -s; fi
