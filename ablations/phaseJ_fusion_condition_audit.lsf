python phaseJ/audit_fusion_conditioning.py \
  --run_dir "phaseJ/runs/phaseJ_fusion_aligned_${PHASEJ_FUSION_ALIGNED_JOB}" \
  --token_dir "phaseJ/fusion_cache/full_${PHASEJ_FUSION_TOKEN_JOB}" \
  --output_dir "phaseJ/audits/fusion_conditioning_${JOB}" \
  --emit_selections \
  --wandb_group "$PHASEJ_GROUP" --wandb_run_name "phaseJ_fusion_conditioning_audit_${JOB}"
