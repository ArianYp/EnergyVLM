#!/usr/bin/env bash
#BSUB -J sd-W-cache118k
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>225000]"
#BSUB -R "rusage[mem=225000]"
#BSUB -M 225000
#BSUB -gpu "num=4:mode=exclusive_process:gmem=80G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-cache118k-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-cache118k-%J.err
#
# Scored candidate cache over the FULL COCO train2017 caption set, for the scale-up run.
#
# Why this job exists: phaseN/records_24k carries `"scores": false` and `oracle_idx: -1`, so every
# 12k/24k experiment in this project was a uniform-selection arm. Neither a VQAScore arm nor a DINO
# arm can be trained at scale until a SCORED cache exists. This builds one.
#
# Parallelism, not batch size. build_coco_selection.py shards with `i % WORLD_SIZE == RANK`, writes
# one JSONL per rank, and performs NO collectives -- so independent processes with hand-set RANK /
# WORLD_SIZE scale it linearly and safely across as many jobs as we like. Deliberately NOT batching
# multiple captions through one transformer call: candidate noise is drawn per candidate from
# `seed + idx*1000 + j` and train_pilot.py re-rolls the trajectory from exactly that seed, so a
# regrouping bug would silently mis-pair captions with candidates. That failure has already occurred
# once in this project (the caption->candidate map agreed at chance) and it does not announce itself.
#
# Resumable: each rank skips prompt ids already present in its own output file.
#
#   bsub -U iclr_2026 -env "all,SHARD=0,NSHARD=4" < ablations/phaseW_cache118k.lsf
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token

: "${SHARD:?set SHARD}"
NSHARD=${NSHARD:-4}
GPUS=${GPUS:-8}
POOL=${POOL:-phaseW/pool118k/pool_manifest.json}
OUT=${OUT:-phaseN/coco_selection_118k}
WORLD=$((NSHARD * GPUS))
mkdir -p "$OUT" logs
test -s "$POOL"

echo "[$(date --iso-8601=seconds)] cache118k | shard $SHARD/$NSHARD, ranks $((SHARD*GPUS))..$((SHARD*GPUS+GPUS-1)) of $WORLD"

pids=()
for g in $(seq 0 $((GPUS - 1))); do
  R=$((SHARD * GPUS + g))
  CUDA_VISIBLE_DEVICES=$g RANK=$R LOCAL_RANK=0 WORLD_SIZE=$WORLD \
    python3 phaseN/build_coco_selection.py \
      --pool_manifest "$POOL" --out_root "$OUT" \
      --N 4 --K 8 --cfg 7.0 --height 512 --seed 0 \
      --baselines dino,clip \
      > "logs/cache118k_r${R}.log" 2>&1 &
  pids+=($!)
done
fail=0
for p in "${pids[@]}"; do wait "$p" || fail=1; done
echo "[$(date --iso-8601=seconds)] shard $SHARD done (fail=$fail); rank files:"
wc -l "$OUT"/selection_rank*.jsonl 2>/dev/null | tail -3
exit $fail
