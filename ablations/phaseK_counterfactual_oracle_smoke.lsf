#!/usr/bin/env bash
#BSUB -J sd-phaseK-cf-oracle-smoke
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 2:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>64000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=64000]"
#BSUB -M 64000
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseK-cf-oracle-smoke-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseK-cf-oracle-smoke-%J.err

set -euo pipefail
export PATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/venv_mmdit/bin:/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=online
source ~/.secrets/hf_token

: "${PHASEK_GROUP:?provide one unique W&B group}"
JOB=${LSB_JOBID:-local}
ROOT="phaseK/oracle/phaseK_counterfactual_smoke_${JOB}"
if [[ -e "$ROOT" ]]; then
  echo "Refusing to overwrite $ROOT" >&2
  exit 2
fi
mkdir -p "$ROOT/scores"

python phaseK/test_counterfactual.py
for SPLIT in train external; do
  if [[ "$SPLIT" == train ]]; then INPUT=exp0/prompts.json; else INPUT=phaseH/pool/prompts.json; fi
  python phaseK/build_counterfactuals.py \
    --input "$INPUT" --output_dir "$ROOT/$SPLIT" --split "$SPLIT" \
    --limit 16 --min_coverage 1 \
    --wandb_group "$PHASEK_GROUP" \
    --wandb_run_name "phaseK_cf_data_${SPLIT}_smoke_${JOB}"
done

torchrun --standalone --nproc-per-node=1 phaseK/score_counterfactual_vqa.py \
  --train_counterfactuals "$ROOT/train/counterfactuals.json" \
  --external_counterfactuals "$ROOT/external/counterfactuals.json" \
  --output_dir "$ROOT/scores"

python phaseK/collect_counterfactual_cache.py \
  --base_token_dir phaseJ/fusion_cache/full_99742 \
  --counterfactual_root "$ROOT" --score_dir "$ROOT/scores" \
  --output_dir "$ROOT/cache" --batch_size 16 \
  --wandb_group "$PHASEK_GROUP" \
  --wandb_run_name "phaseK_cf_cache_smoke_${JOB}"

test -s "$ROOT/cache/train_counterfactual.pt"
test -s "$ROOT/cache/external_counterfactual.pt"
echo "[$(date --iso-8601=seconds)] Phase-K oracle smoke complete: $ROOT"
