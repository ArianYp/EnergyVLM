#!/usr/bin/env bash
#BSUB -J sd-phaseG-eval
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseG-eval-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseG-eval-%J.err
# Phase G k=3 verdict: branch-and-select oracle vs random (target channel, input held fixed).
# INTERPRETATION DEPENDS ON THE CEILING (job 87332): a null here licenses "the treatment did
# nothing measurable"; only the ceiling licenses "nothing measurable was available".
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token
echo "[`date`] Phase G k=3 eval | Host: $(hostname)"
for spec in "Gorc:checkpoints/phaseG/phaseG_oracle_20260726_135832_87065/checkpoint_final.pt" "Grnd:checkpoints/phaseG/phaseG_random_20260726_141439_87066/checkpoint_final.pt"; do
  L=${spec%%:*}; CK=${spec#*:}
  torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
    --out_root phaseC/eval --label $L --checkpoint "$CK" --cfg 1 \
    --split val --steps_list 4 --per_category 1000
done
python3 phaseC/test_3in1_identity.py
for MODEL in Gorc Grnd; do
  for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
    D=phaseC/eval_scores/${MODEL}_s4_${CAT}
    [ -f "$D/scores.json" ] && continue
    python3 phaseC/compbench_eval.py stage --images phaseC/eval/images/${MODEL} \
      --prompts phaseC/eval/prompts.json --steps 4 --categories ${CAT} --out "$D"
    python3 phaseC/compbench_eval.py run     --dir "$D" --skip_done
    python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split val
  done
done
python3 phaseC/eval_analyze.py --scores_dir phaseC/eval_scores --step 4 \
  --models Gorc,Grnd --title "Phase G (branch-and-select, k=3)" \
  --fidelity /nonexistent --diversity /nonexistent \
  --out phaseG/verdict_branch_k3.md
cat phaseG/verdict_branch_k3.md
echo "[`date`] DONE"
