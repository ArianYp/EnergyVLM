#!/usr/bin/env bash
#BSUB -J sd-W-train118k-ema
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>225000]"
#BSUB -R "rusage[mem=225000]"
#BSUB -M 225000
#BSUB -gpu "num=4:mode=exclusive_process:gmem=80G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-train118k-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-W-train118k-%J.err
#
# Scale-up: 2 epochs over the FULL COCO train2017 caption set, 8 GPUs, one arm per job.
#
# WHY THIS IS THE RIGHT AXIS. The selection gain decays with OPTIMISER STEPS on a small caption
# set -- B4-over-B2 is +0.0233 at 6k steps and +0.0143 at 40k, which on 3,000 captions is 13
# epochs of re-visiting the same prompts. It did NOT decay with caption count: the coupling effect
# held at +0.082 on both 12k and 24k captions. This run holds epochs at 2 and multiplies captions
# by ~40x, so for the first time "more updates" and "more repetition" are separated.
#
# train_pilot.py uses a DistributedSampler, so each caption is seen exactly once per GLOBAL epoch:
#   num_steps = epochs * n_captions / world.   118287 * 2 / 8 = 29572.
#
# LR is scaled by sqrt(8) for the 8x effective batch and is IDENTICAL across arms, so the
# arm-vs-arm contrast stays matched even though absolute quality is not comparable to the 6k runs.
#
#   bsub -U iclr_2026 -env "all,VARIANT=CD_dinop_hard,SEED=0" < ablations/phaseW_train118k.lsf
#   bsub -U iclr_2026 -env "all,VARIANT=B4,SEED=0"            < ablations/phaseW_train118k.lsf
#   bsub -U iclr_2026 -env "all,VARIANT=B2,SEED=0"            < ablations/phaseW_train118k.lsf
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token

: "${VARIANT:?set VARIANT}"
SEED=${SEED:-0}
SELDIR=${SELDIR:-phaseN/coco_selection_118k}
GPUS=${GPUS:-4}
EPOCHS=${EPOCHS:-2}
LR=${LR:-2e-5}
JOB=${LSB_JOBID:-manual}

NREC=$(cat "$SELDIR"/selection_rank*.jsonl 2>/dev/null | wc -l)
[ "$NREC" -gt 0 ] || { echo "empty selection dir $SELDIR" >&2; exit 2; }
STEPS=$(python3 -c "print(int(round($EPOCHS * $NREC / $GPUS)))")
RUN="phaseW_${VARIANT}_118k-ema_s${SEED}_${JOB}"
OUT="checkpoints/phaseW/${RUN}"
mkdir -p checkpoints/phaseW logs

echo "[$(date --iso-8601=seconds)] train118k | variant=$VARIANT seed=$SEED cache=$SELDIR"
echo "  captions=$NREC  gpus=$GPUS  epochs=$EPOCHS  ->  num_steps=$STEPS  lr=$LR  -> $RUN"

torchrun --standalone --nproc-per-node="$GPUS" phaseW/train_pilot_frozen_ema.py \
  --variant "$VARIANT" --coupling fresh --distill_loss x0_huber \
  --seed "$SEED" --sel_seed "$SEED" \
  --selection_dir "$SELDIR" \
  --alpha 1.0 --temp 1.0 \
  --N 4 --K 8 --cfg 7.0 --student_cfg 0.0 --cfg_mode composed \
  --num_steps "$STEPS" --num_warmup_steps 1000 --lr "$LR" --weight_decay 0.0 --grad_clip 1.0 \
  --height 512 --sched_shift 3.0 --num_train_ts 1000.0 \
  --delta_min 1 --delta_max 3 \
  --scoring_window 0.4,0.9 \
  --support_m 1 --assign_seed 982451653 \
  --huber_c 0.0 --gradient_checkpointing \
  --save_every 5000 --log_every 50 \
  --sample_every "${SAMPLE_EVERY:-2000}" --sample_prompts "${SAMPLE_PROMPTS:-phaseW/sample_prompts.json}" \
  --sample_steps 4 --sample_cfg 1.0 --ema_decay "${EMA:-0.9999}" \
  --wandb_project sd-phaseW-118k --wandb_run_name "$RUN" \
  --output_dir "$OUT"

echo "[$(date --iso-8601=seconds)] train118k done: $RUN"
