#!/usr/bin/env bash
#BSUB -J sd-phaseH-noise-gate
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseH-noise-gate-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseH-noise-gate-%J.err
# PHASE H GATE — is there headroom in the NOISE channel, before training anything?
#
# Phase G trained two models before we measured that its headroom on the primary was
# +0.0127 CI[-0.0011,+0.0263] — non-identifying. Not repeating that. This is zero-training:
# best-of-4 over the STUDENT's own initial seeds, selected by VQAScore, judged by the
# official evaluators. Same selection rule and same non-oracle control as C1 and Phase G.
#
# PRE-REGISTERED READ (fixed before any number is seen):
#   headroom CI excludes 0 and >= +0.02  -> GREENLIGHT the H1 refiner
#   headroom CI excludes 0 but < +0.02   -> proceed only with the effect size stated as the cap
#   headroom CI includes 0               -> the channel is non-identifying; do NOT train.
# The gate is on the PRIMARY metric, never on VQAScore (which selection optimises directly).
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token
echo "[`date`] Phase H noise-channel gate | Host: $(hostname)"

M1=checkpoints/method/M1_pure_consistency_20260624_065127_55187/checkpoint_final.pt

# 1. four seeds per held-out prompt from the frozen student (cand0..cand3)
torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
  --out_root phaseH/gen --label M1 --checkpoint "$M1" --cfg 1 \
  --split val --steps_list 4 --per_category 1000 --n_seeds 4

# 2. score all four with VQAScore (the selector used throughout), reusing exp0's scorer.
#    It expects {out_root}/images/p{idx}/{config}/cand{j}.png, so expose the label dir as
#    the image root rather than forking the script.
mkdir -p phaseH/pool
cp -f phaseH/gen/prompts.json phaseH/pool/prompts.json
[ -e phaseH/pool/images ] || ln -s "$PWD/phaseH/gen/images/M1" phaseH/pool/images
torchrun --standalone --nproc-per-node=4 exp0/score_candidates.py \
  --out_root phaseH/pool --pool_size 4

# 3. oracle / non-oracle selection pools + the reward-extremity readout
python3 phaseH/build_noise_headroom.py \
  --pool_root phaseH/pool --images_root phaseH/gen/images/M1 --config s4 \
  --out phaseH/noise_headroom --N 4 --steps_tag 4

# 4. how extreme is the selected NOISE itself? (decides whether H1 can use a regression loss)
python3 phaseH/measure_noise_extremity.py \
  --selection phaseH/noise_headroom/selection.json --N 4

# 5. the official evaluators on both selections — this is the gate
for MODEL in oracle random; do
  for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
    D=phaseH/scores/${MODEL}_s4_${CAT}
    [ -f "$D/scores.json" ] && continue
    python3 phaseC/compbench_eval.py stage --images phaseH/noise_headroom/images/${MODEL} \
      --prompts phaseH/noise_headroom/prompts.json --steps 4 --categories ${CAT} --out "$D"
    python3 phaseC/compbench_eval.py run     --dir "$D" --skip_done
    python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split val
  done
done

echo "=== PHASE H GATE: noise-channel headroom on the PRIMARY metric ==="
python3 phaseC/eval_analyze.py --scores_dir phaseH/scores --step 4 --models oracle,random,M1

echo "[`date`] DONE"
