#!/usr/bin/env bash
#BSUB -J sd-phaseJ-shuffle-official
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 4:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>32000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=32000]"
#BSUB -M 32000
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseJ-shuffle-official-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseJ-shuffle-official-%J.err

set -euo pipefail
export PATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/venv_mmdit/bin:/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export WANDB_MODE=online
: "${PHASEJ_GROUP:?missing PHASEJ_GROUP}"
: "${PHASEJ_FUSION_AUDIT_JOB:?missing selection-emitting audit job id}"
JOB=${LSB_JOBID:-local}
AUDIT="phaseJ/audits/fusion_conditioning_${PHASEJ_FUSION_AUDIT_JOB}"
MODE=shuffled
LABEL=mmdit_fusion_shuffled
ROOT="$AUDIT/${MODE}/official_${JOB}"
mkdir -p "$ROOT/scores"

for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
  D="$ROOT/scores/${LABEL}_s4_${CAT}"
  python phaseC/compbench_eval.py stage \
    --images "$AUDIT/${MODE}/selection/images/${LABEL}" \
    --prompts "$AUDIT/${MODE}/selection/prompts.json" \
    --steps 4 --categories "$CAT" --out "$D"
  python phaseC/compbench_eval.py run --dir "$D" --skip_done
  python phaseC/compbench_eval.py collect --dir "$D" --routing_split val
  ln -s "$(realpath "phaseH/scores/random_s4_${CAT}")" "$ROOT/scores/random_s4_${CAT}"
  ln -s "$(realpath "phaseH/scores/oracle_s4_${CAT}")" "$ROOT/scores/oracle_s4_${CAT}"
done

python phaseC/eval_analyze.py --scores_dir "$ROOT/scores" --step 4 \
  --models "${LABEL},random,oracle" --title "Same fusion model with shuffled wrong prompts" \
  --geneval2_dir "$ROOT/not_run" --fidelity "$ROOT/not_run.json" --diversity "$ROOT/not_run.json" \
  --out "$ROOT/official_vs_random.md"
python phaseJ/log_counterfactual_official_wandb.py --root "$ROOT" --model_label "$LABEL" \
  --project sd-mmdit-ranker-v1 --group "$PHASEJ_GROUP" \
  --run_name "phaseJ_fusion_shuffled_official_${JOB}"
