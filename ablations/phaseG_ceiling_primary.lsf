#!/usr/bin/env bash
#BSUB -J sd-phaseG-ceil-primary
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseG-ceil-primary-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseG-ceil-primary-%J.err
# THE DISCRIMINATOR: MAP dose on the PRIMARY metric, not on VQAScore.
#   <= 0        -> reward CURVATURE explains the Phase-G harm; one mechanism, no idiosyncrasy needed
#   ~ +0.035    -> curvature fails; selector IDIOSYNCRASY is live and 87579 becomes decisive
# Re-runs the aggregation with the same seeds and saves the aggregated latents as images, then
# scores them with the official CompBench evaluators. Inference only.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token
echo "[`date`] Phase G ceiling on the PRIMARY metric | Host: $(hostname)"
torchrun --standalone --nproc-per-node=4 phaseG/measure_ceiling.py \
  --n_prompts 400 --N 32 --M 4 --branch_points 3 --K 8 --cfg 7.0 --eta 0.9 \
  --save_images phaseG/ceiling_primary --out phaseG/ceiling_report_k3only.md
# prompt pool for the join (same 400-prompt subset, same seed)
python3 - <<'PY'
import json, sys
from pathlib import Path
sys.path.insert(0,"exp0")
import numpy as np
from generate_candidates import build_dev_pool
pool = build_dev_pool(Path("T2I-CompBench/examples/dataset"), 1000, 0, split="train")
rng = np.random.default_rng(0)
sub = [pool[i] for i in rng.choice(len(pool), size=400, replace=False)]
Path("phaseG/ceiling_primary").mkdir(parents=True, exist_ok=True)
Path("phaseG/ceiling_primary/prompts.json").write_text(json.dumps(sub, indent=1))
print(f"pool for join: {len(sub)} prompts")
PY
python3 phaseC/test_3in1_identity.py
for MODEL in ceilwin_k3 ceillos_k3; do
  for CAT in color shape texture spatial 3d_spatial numeracy complex; do
    D=phaseG/ceiling_primary/scores/${MODEL}_s8_${CAT}
    [ -f "$D/scores.json" ] && continue
    python3 phaseC/compbench_eval.py stage --images phaseG/ceiling_primary/images/${MODEL} \
      --prompts phaseG/ceiling_primary/prompts.json --steps 8 --categories ${CAT} --out "$D"
    python3 phaseC/compbench_eval.py run     --dir "$D" --skip_done
    python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split train
  done
done
echo "=== MAP DOSE ON THE PRIMARY METRIC (the discriminator) ==="
python3 phaseC/eval_analyze.py --scores_dir phaseG/ceiling_primary/scores --step 8 \
  --models ceilwin_k3,ceillos_k3 --title "Ceiling on the PRIMARY metric (k=3)" \
  --fidelity /nonexistent --diversity /nonexistent \
  --out phaseG/ceiling_primary/verdict.md
cat phaseG/ceiling_primary/verdict.md
echo "[`date`] DONE"
