#!/usr/bin/env bash
#BSUB -J sd-exp0b-headroom
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 8
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-exp0b-headroom-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-exp0b-headroom-%J.err
# Exp-0b — THE load-bearing check: does VQA-best-of-4 selection move the PRIMARY (independent)
# metric at all, before any distillation? Exp-0's +0.126 was VQAScore selecting on VQAScore.
# Zero-training: reuses the Exp-0 candidate pool + cached VQA scores; only scoring is new.
# exp0 prompts are the TRAIN split -> routing_split train for the 3-in-1 `complex` category.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
source ~/.secrets/hf_token
echo "[`date`] Exp-0b primary-metric headroom | Host: $(hostname)"
python3 exp0/build_primary_headroom.py
python3 phaseC/test_3in1_identity.py
for MODEL in oracle random; do
  for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
    D=exp0/primary_headroom/scores/${MODEL}_s8_${CAT}
    [ -f "$D/scores.json" ] && { echo "skip $D"; continue; }
    python3 phaseC/compbench_eval.py stage --images exp0/primary_headroom/images/${MODEL} \
      --prompts exp0/primary_headroom/prompts.json --steps 8 --categories ${CAT} --out "$D"
    python3 phaseC/compbench_eval.py run     --dir "$D" --skip_done
    python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split train
  done
done
echo "=== HEADROOM ON THE PRIMARY METRIC (the number Exp-0 never measured) ==="
python3 phaseC/eval_analyze.py --scores_dir exp0/primary_headroom/scores --step 8 \
  --models oracle,random --title "Exp-0b (best-of-4 selection, teacher candidates, NO training)" \
  --fidelity /nonexistent --diversity /nonexistent \
  --out exp0/primary_headroom/verdict.md
cat exp0/primary_headroom/verdict.md
echo "[`date`] DONE"
