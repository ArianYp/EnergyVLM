#!/usr/bin/env bash
#BSUB -J sd-phaseG-followup
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseG-followup-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseG-followup-%J.err
# Phase G follow-up, two things:
#  (A) IN-OBJECTIVE VQA for Gorc/Grnd. The k=3 arms are significantly WORSE on the independent
#      primary (-0.0222). If they are simultaneously BETTER on VQAScore -- the selector -- then
#      the target channel DOES move the student, and what it transfers is the selector's
#      idiosyncrasy rather than alignment: a NEGATIVE transfer ratio. That is a far stronger
#      statement than a null and it needs the VQA number to make.
#  (B) the k=6 LOW-DOSE arms -> dose-response along sigma.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token
echo "[`date`] Phase G follow-up | Host: $(hostname)"

echo "=== (A) in-objective VQAScore for the k=3 arms ==="
torchrun --standalone --nproc-per-node=4 exp0/phaseA_score.py \
  --out_root phaseC/eval --labels Gorc,Grnd --steps_list 4

echo "=== (B) k=6 low-dose arms: generate + score ==="
for spec in "Gorc6:checkpoints/phaseG/phaseG_oracle_k6_20260726_150446_87088/checkpoint_final.pt" "Grnd6:checkpoints/phaseG/phaseG_random_k6_20260726_152430_87089/checkpoint_final.pt"; do
  L=${spec%%:*}; CK=${spec#*:}
  torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
    --out_root phaseC/eval --label $L --checkpoint "$CK" --cfg 1 \
    --split val --steps_list 4 --per_category 1000
done
python3 phaseC/test_3in1_identity.py
for MODEL in Gorc6 Grnd6; do
  for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
    D=phaseC/eval_scores/${MODEL}_s4_${CAT}
    [ -f "$D/scores.json" ] && continue
    python3 phaseC/compbench_eval.py stage --images phaseC/eval/images/${MODEL} \
      --prompts phaseC/eval/prompts.json --steps 4 --categories ${CAT} --out "$D"
    python3 phaseC/compbench_eval.py run     --dir "$D" --skip_done
    python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split val
  done
done

echo "=== VERDICTS ==="
python3 phaseC/eval_analyze.py --scores_dir phaseC/eval_scores --step 4 \
  --models Gorc,Grnd --vqa phaseC/eval/scores \
  --title "Phase G k=3 (with transfer ratio)" \
  --fidelity /nonexistent --diversity /nonexistent \
  --out phaseG/verdict_branch_k3.md
python3 phaseC/eval_analyze.py --scores_dir phaseC/eval_scores --step 4 \
  --models Gorc6,Grnd6 --title "Phase G k=6 (LOW dose, +0.0156)" \
  --fidelity /nonexistent --diversity /nonexistent \
  --out phaseG/verdict_branch_k6.md
echo "--- k=3 (high dose) ---"; grep -A3 "PRIMARY 1" phaseG/verdict_branch_k3.md | head -4
grep -A3 "transfer ratio" phaseG/verdict_branch_k3.md | head -5
echo "--- k=6 (low dose) ---"; grep -A3 "PRIMARY 1" phaseG/verdict_branch_k6.md | head -4
echo "[`date`] DONE"
