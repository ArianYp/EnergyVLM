#!/usr/bin/env bash
#BSUB -J sd-phaseX-cache
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 12:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseX-cache-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseX-cache-%J.err
# Reroll every candidate and cache its endpoint latent. Label-independent: touches no official
# label, no counterfactual prompt and no score, so it cannot break the evaluation seal.
# Each shard runs a stratified bit-exact preflight and ABORTS if any item fails to reproduce.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token
: "${CAND:?set CAND 0..7}"
python3 phaseX/reroll_cache.py --cand "$CAND" --setname "${SETNAME:-compbench}" --audit_n 8
