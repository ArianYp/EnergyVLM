#!/usr/bin/env bash
#BSUB -J sd-phaseG-eval-extremity
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseG-eval-extremity-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseG-eval-extremity-%J.err
# Does the Phase-G harm track the reward TILT or the target's EXTREMITY?
#   argmax : tilt +0.082, extremity 1.05 SD   (done: -0.0222)
#   median : tilt +0.042, extremity 0.42 SD
#   argmin : tilt -0.082, extremity 1.05 SD   <- same extremity as argmax, opposite tilt
# Extremity account -> argmin harms like argmax. Reward account -> they differ.
# All compared against the SAME existing control arm (Grnd), so only 2 new models were trained.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token
echo "[`date`] Phase G extremity-vs-reward | Host: $(hostname)"
MED=$(ls -dt checkpoints/phaseG/phaseG_median_*/checkpoint_final.pt | head -1)
ANT=$(ls -dt checkpoints/phaseG/phaseG_antioracle_*/checkpoint_final.pt | head -1)
for spec in "Gmed:$MED" "Gant:$ANT"; do
  L=${spec%%:*}; CK=${spec#*:}
  echo "=== $L <- $CK ==="
  torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
    --out_root phaseC/eval --label $L --checkpoint "$CK" --cfg 1 \
    --split val --steps_list 4 --per_category 1000
done
python3 phaseC/test_3in1_identity.py
for MODEL in Gmed Gant; do
  for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
    D=phaseC/eval_scores/${MODEL}_s4_${CAT}
    [ -f "$D/scores.json" ] && continue
    python3 phaseC/compbench_eval.py stage --images phaseC/eval/images/${MODEL} \
      --prompts phaseC/eval/prompts.json --steps 4 --categories ${CAT} --out "$D"
    python3 phaseC/compbench_eval.py run     --dir "$D" --skip_done
    python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split val
  done
done
for M in Gmed Gant; do
  python3 phaseC/eval_analyze.py --scores_dir phaseC/eval_scores --step 4 \
    --models ${M},Grnd --title "Phase G ${M} vs the shared control" \
    --fidelity /nonexistent --diversity /nonexistent \
    --out phaseG/verdict_${M}.md
done
echo "=== EXTREMITY vs REWARD ==="
python3 - <<'PY'
import json
rows=[("argmax (oracle)", +0.0816, 1.05, -0.0222, None),
      ("median",          +0.0421, 0.42, None, "phaseG/verdict_Gmed.json"),
      ("argmin (anti)",   -0.0816, 1.05, None, "phaseG/verdict_Gant.json")]
print(f"  {'arm':16s} {'tilt':>8s} {'extremity':>10s} {'observed Δ':>12s}")
for lab,tilt,ext,obs,f in rows:
    if obs is None:
        try: obs=json.load(open(f))["primary"]["delta"]
        except Exception: obs=float('nan')
    print(f"  {lab:16s} {tilt:+8.4f} {ext:10.2f} {obs:+12.4f}")
print("""
  READ
   argmin harm ~= argmax harm      -> EXTREMITY drives it (reward geometry NOT the cause)
   argmin differs from argmax      -> REWARD drives it (curvature account survives)
   median harm ~= 0.5 x argmax     -> harm scales with tilt, supporting reward""")
PY
echo "[`date`] DONE"
