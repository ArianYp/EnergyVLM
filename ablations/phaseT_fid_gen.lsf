#!/usr/bin/env bash
#BSUB -J sd-phaseT-fidgen
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -W 8:00
#BSUB -n 4
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000]"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseT-fidgen-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseT-fidgen-%J.err
#
# Generate the 5,000-COCO-caption pool used for FID / CMMD / precision / recall, one job per
# (arm, seed). The project's existing fidelity report was computed on phaseC checkpoints, which are
# NOT the models this paper reports, and it has a single run per arm with no seed variation.
#
# Sampling CFG matters and is the bug that voided our first Phase-T eval pass: students trained with
# --student_cfg 0 have guidance INTERNALISED and must be sampled CFG-free (cfg 1). The undistilled
# base model has not internalised anything and is sampled at its native cfg 7. Pass FID_CFG
# explicitly for every job; never let it default.
#
# 1 GPU per job so many run concurrently -- generation is rank-invariant (phaseA_generate.py shards
# by idx % world and seeds by args.seed + pidx), so world size does not change the images.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token

: "${FID_LABEL:?set FID_LABEL}"
: "${FID_CKPT:?set FID_CKPT (path or the string 'base')}"
: "${FID_CFG:?set FID_CFG explicitly (1.0 for distilled students, 7.0 for base)}"
STEPS=${FID_STEPS:-4}
ROOT=phaseT/fidelity

test -s phaseC/fidelity/prompts.json
mkdir -p "$ROOT"
cp -n phaseC/fidelity/prompts.json "$ROOT/prompts.json" 2>/dev/null || true

if [ -d "$ROOT/images/$FID_LABEL" ] && [ "$(ls "$ROOT/images/$FID_LABEL" | wc -l)" -ge 5000 ]; then
  echo "[fidgen] $FID_LABEL already has 5000 images, skipping"; exit 0
fi

echo "[$(date --iso-8601=seconds)] fidgen | label=$FID_LABEL ckpt=$FID_CKPT cfg=$FID_CFG steps=$STEPS"
torchrun --standalone --nproc-per-node=1 exp0/phaseA_generate.py \
  --out_root "$ROOT" --label "$FID_LABEL" --checkpoint "$FID_CKPT" \
  --cfg "$FID_CFG" --prompts_json "$ROOT/prompts.json" --steps_list "$STEPS"
echo "[$(date --iso-8601=seconds)] fidgen done: $FID_LABEL ($(ls "$ROOT/images/$FID_LABEL" | wc -l) prompts)"
