#!/usr/bin/env bash
#BSUB -J sd-abl-kl-plogp
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 168:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>64000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=64000]"
#BSUB -M 64000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-abl-kl-plogp-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-abl-kl-plogp-%J.err

# ============================================================================
# K2_kl_plogp — KL-to-base anchor test (keep the FAST EMA, add a frozen-base pull)
#   plogp KL form: matches distribution SHAPE (scale-invariant).
#   single-variable override vs B0:  --lambda_kl 100 --kl_form plogp
# Setup is the ORIGINAL diverging config (ema_decay=0.999 — blows up by ~step
# 2k) PLUS the KL anchor only. If d_mean / xhat_norm_mean stay FLAT to 20k with
# the fast EMA, the KL-to-base term is a true cure (not just a delay like
# ema_decay=0.9999, which broke at ~20-25k in the 50k P1 run).
# WATCH in W&B: train/d_mean, train/xhat_norm_mean vs train/xtea_norm_mean,
#   train/L_kl + train/loss_kl_weighted (is the anchor biting?),
#   train/param_l2_divergence (||student-EMA||), samples/student.
# TUNING: lambda_kl=100 is a STARTING estimate (MSE form averages over 65536
#   latent dims, so it is small-magnitude — may need to go higher). If d_mean
#   still diverges -> raise lambda_kl; if d_mean is pinned high with no learning
#   -> lower it. The L_kl curve tells us which regime we are in.
# ============================================================================

set -euo pipefail
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export NCCL_NVLS_ENABLE=0
source ~/.secrets/hf_token
mkdir -p "$HF_HOME" "$TORCH_HOME" "$XDG_CACHE_HOME" logs

echo "[`date`] K2_kl_plogp | override: --lambda_kl 100 --kl_form plogp"
echo "Host: $(hostname) | LSF: ${LSB_JOBID:-unknown}"
nvidia-smi --query-gpu=index,name,memory.total --format=csv

RUN_NAME="K2_kl_plogp_$(date +%Y%m%d_%H%M%S)_${LSB_JOBID:-local}"

torchrun --standalone --nproc-per-node=4 \
  train_self_distill.py \
  --output_dir "checkpoints/ablation/${RUN_NAME}" \
  --coco_split train2017 --feature_encoder clip --clip_id openai/clip-vit-large-patch14 \
  --num_steps 20000 --num_warmup_steps 500 \
  --lr 1e-5 --projector_lr 1e-4 --weight_decay 0.0 \
  --grad_clip 1.0 --projector_grad_clip 5.0 \
  --N_traj 4 --K_steps 8 --scoring_window 0.4,0.9 --delta_min 1 --delta_max 3 \
  --tau_N 1.0 --tau_K 1.0 --score_norm zscore \
  --ema_decay 0.999 --distance pseudo_huber --guidance_scale 7.0 \
  --lambda_align 1.0 --lambda_reward 1.0 --lambda_fm 0.0 \
  --gradient_checkpointing \
  --save_every 5000 --sample_every 1000 --probe_every 0 --log_every 10 \
  --save_train_images_every 2000 --log_image_samples --sample_inference_steps 28 \
  --wandb_project sd-self-distill-ablation --wandb_run_name "${RUN_NAME}" \
  --lambda_kl 100 --kl_form plogp

if command -v my-job-stats >/dev/null 2>&1; then my-job-stats -a -n -s; fi
