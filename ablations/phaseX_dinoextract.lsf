#!/usr/bin/env bash
#BSUB -J sd-phaseX-dinoext
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 6:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>96000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=96000]"
#BSUB -M 96000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseX-dinoext-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseX-dinoext-%J.err
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token
: "${CAND:?set CAND}"
# the PCA basis is a hard dependency; wait rather than fail so all 8 shards can be queued at once
n=0; until [ -s phaseX/dino_pca/pca.pt ]; do n=$((n+1)); [ $n -gt 240 ] && { echo "PCA never appeared" >&2; exit 3; }; sleep 30; done
python3 phaseX/extract_candidate_dino.py --cand "$CAND" --sets compbench,geneval2
