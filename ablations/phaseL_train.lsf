#!/usr/bin/env bash
#BSUB -J sd-phaseL-train
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseL-train-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseL-train-%J.err

set -euo pipefail

export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export NCCL_NVLS_ENABLE=0
export WANDB_MODE=online
source ~/.secrets/hf_token

: "${PHASEL_GROUP:?missing Phase-L W&B group}"
: "${PHASEL_SELECTION_JOB:?missing Phase-L selection job id}"
: "${PHASEL_GATE_JOB:?missing Phase-L promotion gate job id}"
: "${PHASEL_SEED:?missing training seed}"
PHASEL_STEPS=${PHASEL_STEPS:-12000}
PHASEL_EXPECTED_RECORDS=${PHASEL_EXPECTED_RECORDS:-22236}
PHASEL_LAMBDA_REPA=${PHASEL_LAMBDA_REPA:-0.5}

JOB=${LSB_JOBID:-local}
SELECTION="phaseL/selection_${PHASEL_SELECTION_JOB}"
GATE="phaseL/promotion_gate_${PHASEL_GATE_JOB}/summary.json"
RUN="phaseL_preference_repa_seed${PHASEL_SEED}_${JOB}"
OUT="checkpoints/phaseL/${RUN}"
if [[ -e "$OUT" ]]; then
  echo "Refusing to overwrite $OUT" >&2
  exit 2
fi
test -s "$GATE"
if ! jq -e '.pass == true' "$GATE" >/dev/null; then
  SKIP="phaseL/skipped_training_${JOB}.json"
  jq -n --arg job "$JOB" --arg seed "$PHASEL_SEED" --arg gate "$GATE" \
    '{skipped:true, job:$job, seed:$seed, reason:"publication promotion gate did not pass", gate:$gate}' \
    > "$SKIP"
  echo "Phase-L publication training skipped by the preregistered gate: $SKIP"
  exit 0
fi
jq -e --argjson expected "$PHASEL_EXPECTED_RECORDS" \
  '.pass == true and .records == $expected and .repeat_count == 4' \
  "$SELECTION/summary.json" >/dev/null

echo "[$(date --iso-8601=seconds)] Phase-L train start | job=$JOB seed=$PHASEL_SEED"
echo "  group=$PHASEL_GROUP selection=$SELECTION output=$OUT steps=$PHASEL_STEPS lambda_repa=$PHASEL_LAMBDA_REPA"
nvidia-smi --query-gpu=index,name,memory.total --format=csv
python3 phaseI/test_preference.py \
  --selection_dir "$SELECTION" --expected_records "$PHASEL_EXPECTED_RECORDS" \
  --min_oracle_margin 0.20

torchrun --standalone --nproc-per-node=4 phaseI/train_preference.py \
  --labels oracle --label_source correct_prompt \
  --selection_dir "$SELECTION" --output_dir "$OUT" \
  --m1_checkpoint checkpoints/method/M1_pure_consistency_20260624_065127_55187/checkpoint_final.pt \
  --num_steps "$PHASEL_STEPS" --num_warmup_steps 400 \
  --lr 1e-6 --weight_decay 0 --grad_clip 1.0 \
  --beta 100 --lambda_anchor 1.0 --preference_timesteps 4 \
  --K 8 --cfg 7.0 --sched_shift 3.0 --height 512 \
  --gradient_checkpointing \
  --seed "$PHASEL_SEED" --label_seed 20260806 \
  --lambda_repa "$PHASEL_LAMBDA_REPA" --repa_layer 8 --repa_projector_lr 1e-4 \
  --save_every 3000 --sample_every 500 --log_every 10 \
  --wandb_project sd-pref-repa-publication-v1 --wandb_run_name "$RUN" \
  --wandb_group "$PHASEL_GROUP" \
  --wandb_tags phaseL,publication,large-scale,preference,repa,three-seed

test -s "$OUT/checkpoint_final.pt"
test -s "$OUT/args.json"
echo "[$(date --iso-8601=seconds)] Phase-L train complete: $OUT/checkpoint_final.pt"
if command -v my-job-stats >/dev/null 2>&1; then
  my-job-stats -a -n -s
fi
