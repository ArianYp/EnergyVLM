#!/usr/bin/env bash
#BSUB -J sd-phaseN-cafe-probe
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
# farm-gpu0504 gives a numerically wrong all-reduce at 4-GPU scale. This job is single-process and
# makes no collective calls, so the known fault cannot apply, but a host with a demonstrated
# anomaly should not be silently in the pool for a headline measurement.
#BSUB -R "select[mem>128000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
# The probe is inference only: SD3.5-M in bf16 (transformer + T5-XXL + 2 CLIP text encoders + VAE)
# plus CLIP-L/14 is about 20 GB, and the batch is 8 latents of 64x64. gmem=40G therefore admits the
# L40S pool, which is normally near-idle, and leaves the 80 GB cards free for training.
#BSUB -gpu "num=1:mode=exclusive_process:gmem=40G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseN-cafe-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseN-cafe-%J.err

# CAFE kill test. Does a counterfactual conditional flow-residual contrast order cached teacher
# candidates semantically? Three stages in ONE queue wait:
#
#   1. smoke   14 records, hard asserts. A bug fails here, before the GPU hours are spent.
#   2. main   ~420 records, stratified 60 per category. The early read.
#   3. full    every C1-covered record with non-zero headroom. The complete per-category answer.
#
# Stage 2 is not wasted work when stage 3 runs: it is a fixed, smaller, deterministically drawn
# subset, so agreement between the two is itself a check that the number is stable.
set -euo pipefail

export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=disabled
source ~/.secrets/hf_token

JOB=${LSB_JOBID:-local}
ROOT="phaseN/cafe_probe_${JOB}"
CAND_SCORES="phaseFP/exact_headroom_101942/cand_scores"
if [[ -e "$ROOT" ]]; then echo "Refusing to overwrite $ROOT" >&2; exit 2; fi
mkdir -p "$ROOT"

echo "[$(date --iso-8601=seconds)] Phase-N CAFE probe | job=$JOB"
nvidia-smi --query-gpu=index,name,memory.total --format=csv

echo "=== 0. Build the C1 edit set and join it to the per-candidate oracle scores ==="
# The join is on prompt TEXT. `idx` is a per-job counter in this project, so joining on it pairs the
# wrong image with the wrong prompt and yields a confident meaningless number. c1_edits.py also
# re-checks that every recorded image path really ends in that row's idx and candidate slot.
test -d "$CAND_SCORES"
python3 phaseN/c1_edits.py \
  --cand_scores "$CAND_SCORES" \
  --out "$ROOT/records_c1.jsonl" \
  --summary "$ROOT/c1_coverage.json" \
  --require_images
test -s "$ROOT/records_c1.jsonl"
python3 -c "
import json,sys
s=json.load(open('$ROOT/c1_coverage.json'))
assert s['missing_images']==0, s['missing_images']
assert s['kept']>1400, s['kept']
print(f\"C1 coverage {s['kept']}/{s['total_rows']} rows = {s['coverage']:.1%}; \"
      f\"headroom-mass coverage {s['headroom_mass_coverage']:.1%}\")
"

echo "=== 1. Smoke: 14 records, 2 per category ==="
python3 phaseN/probe_cafe.py \
  --records "$ROOT/records_c1.jsonl" --per_category 2 --skip_flat \
  --bootstrap 200 --progress_every 2 --out "$ROOT/probe_smoke.json"
python3 -c "
import json, math
d=json.load(open('$ROOT/probe_smoke.json'))
s=d['summary']; rows=d['rows']
assert s['n_records']==14, s['n_records']
for arm in ('cafe_c1','cafe_c2','cafe_uncontrolled','raw_residual_low','clip'):
    assert arm in s['arms'], f'missing arm {arm}'
for r in rows:
    for name, v in r['scores'].items():
        assert len(v)==4, (name, len(v))
        assert all(math.isfinite(x) for x in v), (r['prompt'], name, v)
    # The inverted-orientation arm must be the exact negation of the primary arm.
    assert all(abs(a+b)<1e-9 for a,b in zip(r['scores']['cafe_c1'], r['scores']['cafe_c1_inverted']))
    # Residuals must be positive and finite, and the four candidates must not be identical:
    # an identical set would mean the same image was scored four times.
    e=r['scores']['energy_p']
    assert all(x>0 for x in e), e
    assert max(e)-min(e) > 0, e
print(f\"smoke OK | {s['seconds_per_record']:.2f} s/record\")
"

echo "=== 2. Main read: 60 records per category ==="
python3 phaseN/probe_cafe.py \
  --records "$ROOT/records_c1.jsonl" --per_category 60 --skip_flat \
  --progress_every 25 --out "$ROOT/probe_main.json" | tee "$ROOT/probe_main.log"
test -s "$ROOT/probe_main.json"

echo "=== 3. Full C1 set ==="
python3 phaseN/probe_cafe.py \
  --records "$ROOT/records_c1.jsonl" --skip_flat \
  --progress_every 50 --out "$ROOT/probe_full.json" | tee "$ROOT/probe_full.log"
test -s "$ROOT/probe_full.json"

echo "=== 4. Report ==="
python3 phaseN/report_cafe.py \
  --coverage "$ROOT/c1_coverage.json" \
  --main "$ROOT/probe_main.json" --full "$ROOT/probe_full.json" \
  --out "$ROOT/RESULTS.md"
cat "$ROOT/RESULTS.md"

echo "[$(date --iso-8601=seconds)] Phase-N CAFE probe complete: $ROOT"
if command -v my-job-stats >/dev/null 2>&1; then
  my-job-stats -a -n -s
fi
