#!/usr/bin/env bash
#BSUB -J sd-phaseK-cf-geneval-smoke
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 1:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>32000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=32000]"
#BSUB -M 32000
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseK-cf-geneval-smoke-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseK-cf-geneval-smoke-%J.err

set -euo pipefail
export PATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/venv_mmdit/bin:/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
source ~/.secrets/hf_token

: "${PHASEK_RANKER_JOB:?provide Phase-K ranker job}"
: "${PHASEK_GROUP:?provide matching W&B group}"
JOB=${LSB_JOBID:-local}
ROOT="phaseK/geneval_smoke/phaseK_counterfactual_${PHASEK_RANKER_JOB}_${JOB}"
RUN="phaseK/runs/phaseK_counterfactual_${PHASEK_RANKER_JOB}"
python phaseK/build_counterfactuals.py \
  --input phaseC/geneval2/prompts.json --output_dir "$ROOT/prompts" \
  --split geneval2 --limit 2 --min_coverage 1 --no_wandb \
  --wandb_group "$PHASEK_GROUP" --wandb_run_name "unused_${JOB}"
python phaseK/eval_geneval_counterfactual.py \
  --run_dir "$RUN" --counterfactuals "$ROOT/prompts/counterfactuals.json" \
  --output_dir "$ROOT/selection" --limit 2 --no_wandb \
  --wandb_group "$PHASEK_GROUP" --wandb_run_name "unused_${JOB}"
test -s "$ROOT/selection/intervention.json"
test -s "$ROOT/selection/scores.npz"
echo "[$(date --iso-8601=seconds)] Phase-K GenEval inference smoke complete: $ROOT"
