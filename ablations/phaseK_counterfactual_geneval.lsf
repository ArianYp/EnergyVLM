#!/usr/bin/env bash
#BSUB -J sd-phaseK-cf-geneval
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 8
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>128000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=128000]"
#BSUB -M 128000
#BSUB -gpu "num=1:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseK-cf-geneval-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseK-cf-geneval-%J.err

set -euo pipefail
export PATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/venv_mmdit/bin:/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=online
source ~/.secrets/hf_token

: "${PHASEK_RANKER_JOB:?provide Phase-K ranker job}"
: "${PHASEK_OFFICIAL_JOB:?provide Phase-K official CompBench job}"
: "${PHASEK_GROUP:?provide matching W&B group}"
JOB=${LSB_JOBID:-local}
OFFICIAL="phaseK/official/phaseK_counterfactual_${PHASEK_RANKER_JOB}_${PHASEK_OFFICIAL_JOB}"
if [[ ! -s "$OFFICIAL/correct_vs_counterfactual.json" ]]; then
  echo "No official counterfactual report; GenEval gate stops."
  exit 0
fi
if ! jq -e '.primary.ci[0] > 0' "$OFFICIAL/correct_vs_counterfactual.json" >/dev/null; then
  echo "Independent CompBench prompt gate is null; GenEval evaluation stops."
  exit 0
fi

ROOT="phaseK/geneval/phaseK_counterfactual_${PHASEK_RANKER_JOB}_${JOB}"
RUN="phaseK/runs/phaseK_counterfactual_${PHASEK_RANKER_JOB}"
if [[ -e "$ROOT" ]]; then
  echo "Refusing to overwrite $ROOT" >&2
  exit 2
fi
mkdir -p "$ROOT"
python phaseK/build_counterfactuals.py \
  --input phaseC/geneval2/prompts.json --output_dir "$ROOT/prompts" \
  --split geneval2 --min_coverage 1 --wandb_group "$PHASEK_GROUP" \
  --wandb_run_name "phaseK_cf_geneval_data_${JOB}"
python phaseK/eval_geneval_counterfactual.py \
  --run_dir "$RUN" --counterfactuals "$ROOT/prompts/counterfactuals.json" \
  --output_dir "$ROOT/selection_smoke" --limit 2 --no_wandb \
  --wandb_group "$PHASEK_GROUP" --wandb_run_name "unused_smoke_${JOB}"
python phaseK/eval_geneval_counterfactual.py \
  --run_dir "$RUN" --counterfactuals "$ROOT/prompts/counterfactuals.json" \
  --output_dir "$ROOT/selection" --wandb_group "$PHASEK_GROUP" \
  --wandb_run_name "phaseK_cf_geneval_selection_${JOB}"

for MODE in correct counterfactual; do
  D="$ROOT/scores/$MODE"
  python phaseC/geneval2_eval.py stage \
    --images "$ROOT/selection/$MODE/images" \
    --pool phaseC/geneval2/prompts.json --steps 4 --out "$D"
  python phaseC/geneval2_eval.py run --dir "$D" --method soft_tifa_gm --skip_done
  python phaseC/geneval2_eval.py collect --dir "$D" --method soft_tifa_gm
done
python phaseK/compare_geneval.py \
  --correct "$ROOT/scores/correct/scores.json" \
  --counterfactual "$ROOT/scores/counterfactual/scores.json" \
  --output_dir "$ROOT/comparison" --wandb_group "$PHASEK_GROUP" \
  --wandb_run_name "phaseK_cf_geneval_compare_${JOB}"
echo "[$(date --iso-8601=seconds)] Phase-K GenEval2 complete: $ROOT"
