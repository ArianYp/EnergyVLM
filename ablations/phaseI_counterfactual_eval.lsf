#!/usr/bin/env bash
#BSUB -J sd-phaseI-cf-eval
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 16
#BSUB -W 24:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=4:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseI-cf-eval-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseI-cf-eval-%J.err

# Held-out test of whether pair orientation depends on the correct prompt text.
set -euo pipefail

export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export NCCL_NVLS_ENABLE=0
export WANDB_MODE=online
source ~/.secrets/hf_token

: "${PHASEI_GROUP:?missing W&B group}"
: "${PHASEI_CF_DATA_JOB:?missing counterfactual-data job id}"
: "${PHASEI_CORRECT_JOB:?missing matched-correct training job id}"
: "${PHASEI_COUNTERFACTUAL_JOB:?missing counterfactual training job id}"

JOB=${LSB_JOBID:-local}
ROOT="phaseI/counterfactual_eval_${JOB}"
if [[ -e "$ROOT" ]]; then
  echo "Refusing to overwrite $ROOT" >&2
  exit 2
fi
mkdir -p "$ROOT"

CORRECT_CKPT="checkpoints/phaseI/phaseI_preference_matched_${PHASEI_CORRECT_JOB}/checkpoint_final.pt"
COUNTERFACTUAL_CKPT="checkpoints/phaseI/phaseI_counterfactual_${PHASEI_COUNTERFACTUAL_JOB}/checkpoint_final.pt"
CORRECT_ARGS="checkpoints/phaseI/phaseI_preference_matched_${PHASEI_CORRECT_JOB}/args.json"
COUNTERFACTUAL_ARGS="checkpoints/phaseI/phaseI_counterfactual_${PHASEI_COUNTERFACTUAL_JOB}/args.json"
for path in "$CORRECT_CKPT" "$COUNTERFACTUAL_CKPT" "$CORRECT_ARGS" "$COUNTERFACTUAL_ARGS"; do
  test -s "$path"
done
jq -e '.label_source == "correct_prompt"' "$CORRECT_ARGS" >/dev/null
jq -e '.label_source == "counterfactual_prompt"' "$COUNTERFACTUAL_ARGS" >/dev/null
jq -e --arg root "phaseI/counterfactual_data_${PHASEI_CF_DATA_JOB}/correct" \
  '.selection_dir == $root' "$CORRECT_ARGS" >/dev/null
jq -e --arg root "phaseI/counterfactual_data_${PHASEI_CF_DATA_JOB}/counterfactual" \
  '.selection_dir == $root' "$COUNTERFACTUAL_ARGS" >/dev/null

echo "[$(date --iso-8601=seconds)] Phase-I counterfactual evaluation | job=$JOB root=$ROOT"
nvidia-smi --query-gpu=index,name,memory.total --format=csv

python3 phaseC/build_eval_pool.py geneval2 --out "$ROOT/geneval2/prompts.json"
python3 phaseC/build_eval_pool.py coco --n 2398 --seed 0 --out "$ROOT/fidelity/prompts.json"

for spec in "CorrectPreference:$CORRECT_CKPT" "CounterfactualPreference:$COUNTERFACTUAL_CKPT"; do
  LABEL=${spec%%:*}
  CKPT=${spec#*:}
  torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
    --out_root "$ROOT/compbench" --label "$LABEL" --checkpoint "$CKPT" --cfg 1 \
    --split val --steps_list 4 --per_category 1000
  torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
    --out_root "$ROOT/geneval2" --label "$LABEL" --checkpoint "$CKPT" --cfg 1 \
    --prompts_json "$ROOT/geneval2/prompts.json" --steps_list 4
  torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
    --out_root "$ROOT/fidelity" --label "$LABEL" --checkpoint "$CKPT" --cfg 1 \
    --prompts_json "$ROOT/fidelity/prompts.json" --steps_list 4
done

python3 phaseC/build_eval_pool.py subset \
  --pool "$ROOT/compbench/prompts.json" --per_category 50 --seed 0 \
  --out "$ROOT/diversity/prompts.json"
for spec in "CorrectPreference:$CORRECT_CKPT" "CounterfactualPreference:$COUNTERFACTUAL_CKPT"; do
  LABEL=${spec%%:*}
  CKPT=${spec#*:}
  torchrun --standalone --nproc-per-node=4 exp0/phaseA_generate.py \
    --out_root "$ROOT/diversity" --label "$LABEL" --checkpoint "$CKPT" --cfg 1 \
    --prompts_json "$ROOT/diversity/prompts.json" --steps_list 4 --n_seeds 4
done

echo "=== Official T2I-CompBench evaluators ==="
for MODEL in CorrectPreference CounterfactualPreference; do
  for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
    D="$ROOT/compbench_scores/${MODEL}_s4_${CAT}"
    python3 phaseC/compbench_eval.py stage \
      --images "$ROOT/compbench/images/${MODEL}" --prompts "$ROOT/compbench/prompts.json" \
      --steps 4 --categories "$CAT" --out "$D"
    python3 phaseC/compbench_eval.py run --dir "$D" --skip_done
    python3 phaseC/compbench_eval.py collect --dir "$D" --routing_split val
  done
done

echo "=== Official GenEval2 Soft-TIFA ==="
for MODEL in CorrectPreference CounterfactualPreference; do
  D="$ROOT/geneval2_scores/${MODEL}_s4"
  python3 phaseC/geneval2_eval.py stage --images "$ROOT/geneval2/images/${MODEL}" \
    --pool "$ROOT/geneval2/prompts.json" --steps 4 --out "$D"
  python3 phaseC/geneval2_eval.py run --dir "$D" --method soft_tifa_gm --skip_done
  python3 phaseC/geneval2_eval.py collect --dir "$D" --method soft_tifa_gm
done

echo "=== Fidelity and diversity non-inferiority gates ==="
python3 phaseC/fidelity_eval.py --gen_root "$ROOT/fidelity/images" \
  --models CorrectPreference,CounterfactualPreference \
  --gate_models CorrectPreference,CounterfactualPreference \
  --title "Phase I counterfactual-label control" --steps 4 \
  --n_ref 2398 --min_gen 2000 --boot 1000 --out "$ROOT/fidelity.md"
python3 phaseC/diversity_eval.py --gen_root "$ROOT/diversity/images" \
  --models CorrectPreference,CounterfactualPreference \
  --gate_models CorrectPreference,CounterfactualPreference \
  --title "Phase I counterfactual-label control" --steps 4 --n_seeds 4 \
  --prompts "$ROOT/diversity/prompts.json" --boot 10000 --out "$ROOT/diversity.md"

echo "=== Paired text-specific causal contrast ==="
python3 phaseC/eval_analyze.py --scores_dir "$ROOT/compbench_scores" --step 4 \
  --models CorrectPreference,CounterfactualPreference \
  --geneval2_dir "$ROOT/geneval2_scores" \
  --fidelity "$ROOT/fidelity.json" --diversity "$ROOT/diversity.json" \
  --title "Phase I text-specific preference signal" \
  --out "$ROOT/correct_vs_counterfactual.md"

echo "=== Immutable W&B evaluation record ==="
python3 phaseI/log_counterfactual_eval_wandb.py \
  --root "$ROOT" --project sd-pref-repa-v1 --group "$PHASEI_GROUP" \
  --run_name "phaseI_counterfactual_eval_${JOB}" \
  --data_job "$PHASEI_CF_DATA_JOB" --correct_job "$PHASEI_CORRECT_JOB" \
  --counterfactual_job "$PHASEI_COUNTERFACTUAL_JOB"

echo "[$(date --iso-8601=seconds)] Phase-I counterfactual evaluation complete: $ROOT"
if command -v my-job-stats >/dev/null 2>&1; then
  my-job-stats -a -n -s
fi
