#!/usr/bin/env bash
#BSUB -J sd-phaseP-projector
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 8
#BSUB -W 12:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>256000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=256000]"
#BSUB -M 256000
#BSUB -gpu "num=1:mode=exclusive_process:gmodel=NVIDIAH200"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseP-projector-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseP-projector-%J.err
# Phase P: (a) save the STEP-0 baseline (base SD3.5 = the student's initialisation) on the
# training-panel prompts at 1/2/4/8/28 steps, and (b) test whether the trained projector
# discriminates ON ITS OWN TRAINING DISTRIBUTION (x_hat0 at scoring-window timesteps) --
# the one input Phase B never tested, and the only remaining way "inert" could be wrong.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
source ~/.secrets/hf_token
echo "[`date`] Phase P projector reproduction | Host: $(hostname)"
python3 phaseP/reproduce_projector.py \
  --m2_ckpt checkpoints/method/M2_full_method_20260624_065133_55188/checkpoint_final.pt \
  --n_prompts 200 --N 4 --K 8 --cfg 7.0 --scoring_window 0.4,0.9 \
  --save_step0 --out phaseP
echo "[`date`] DONE -> phaseP/projector_repro.md + phaseP/step0_base/"
