#!/usr/bin/env bash
#BSUB -J sd-phaseT-fidscore
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -W 8:00
#BSUB -n 8
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>200000]"
#BSUB -R "rusage[mem=200000]"
#BSUB -M 200000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseT-fidscore-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseT-fidscore-%J.err
#
# FID / CMMD / precision / recall for the paper's arms, PER SEED.
#
# The project's existing fidelity_report.json has one run per arm and was computed on phaseC
# checkpoints, which are not the models this paper reports. This scores the 11 pools generated by
# ablations/phaseT_fid_gen.lsf: B2 / B4 / CD_clip_hard at 3 seeds each, plus the undistilled base at
# 4 and 28 steps. 5,000 COCO captions per pool, scored against 5,000 COCO-val2017 reals.
#
# Per-seed numbers matter here because the fidelity claim is a NULL ("scoring costs no fidelity"),
# and a null asserted from a single run per arm is not a null, it is an absence of measurement.
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export PYTHONPATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM:${PYTHONPATH:-}"
source ~/.secrets/hf_token

MODELS=$(ls phaseT/fidelity/images | tr '\n' ',' | sed 's/,$//')
echo "[$(date --iso-8601=seconds)] scoring pools: $MODELS"

python3 phaseC/test_metrics.py

python3 phaseC/fidelity_eval.py \
  --gen_root phaseT/fidelity/images \
  --models "$MODELS" \
  --gate_models T_B4_s0,T_B2_s0 \
  --steps 4,28 \
  --n_ref 5000 --min_gen 1000 \
  --title "Phase-T per-seed fidelity" \
  --out phaseT/fidelity_report.md

echo "[$(date --iso-8601=seconds)] done -> phaseT/fidelity_report.md"
