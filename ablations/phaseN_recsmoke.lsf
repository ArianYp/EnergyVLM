#!/usr/bin/env bash
#BSUB -J sd-phaseN-recsmoke
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 1:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>96000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=96000]"
#BSUB -M 96000
#BSUB -gpu "num=1:mode=exclusive_process:gmem=78G"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseN-recsmoke-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseN-recsmoke-%J.err
set -euo pipefail
export PATH="/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=disabled
source ~/.secrets/hf_token
T0=$(date +%s)
python3 phaseN/bestofk_recommended.py --out_root phaseN/_recsmoke --sets compbench --K 2 --limit 2
T1=$(date +%s)
echo "smoke: 2 prompts x 2 images took $((T1-T0)) s on one GPU"
python3 - <<'PY'
import glob
from PIL import Image
import numpy as np
fs=sorted(glob.glob("phaseN/_recsmoke/compbench/images/pool/p*/s40/cand*.png"))
print(f"{len(fs)} images")
for f in fs:
    im=Image.open(f); a=np.asarray(im).astype(np.float32)/255
    print(f"  {f.split('/')[-3]}/{f.split('/')[-1]} {im.size} clipped={np.mean((a<0.02)|(a>0.98))*100:.1f}% std={a.std():.3f}")
PY
