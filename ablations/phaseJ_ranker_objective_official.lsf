#!/usr/bin/env bash
#BSUB -J sd-phaseJ-objective-official
#BSUB -G s10396
#BSUB -q training-parallel
#BSUB -n 4
#BSUB -W 8:00
#BSUB -R "span[hosts=1]"
#BSUB -R "select[mem>32000 && hname!='farm-gpu0504']"
#BSUB -R "rusage[mem=32000]"
#BSUB -M 32000
#BSUB -gpu "num=1:mode=exclusive_process"
#BSUB -cwd /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM
#BSUB -o /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseJ-objective-official-%J.out
#BSUB -e /lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/logs/lsf-sd-phaseJ-objective-official-%J.err

set -euo pipefail
export PATH="/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/venv_mmdit/bin:/software/cellgen/team361/ha11/envs/nichejepa/bin:$PATH"
export HF_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/huggingface
export TORCH_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/torch
export XDG_CACHE_HOME=/lustre/scratch126/cellgen/lotfollahi/ha11/EnergyVLM/cache/xdg
export TOKENIZERS_PARALLELISM=false
export WANDB_MODE=online
source ~/.secrets/hf_token

: "${PHASEJ_OBJECTIVE_ARM:?provide the source arm}"
: "${PHASEJ_OBJECTIVE_TRAIN_JOB:?provide the completed training job id}"
: "${PHASEJ_GROUP:?provide the matching W&B group}"

JOB=${LSB_JOBID:-local}
AUDIT="phaseJ/audits/phaseJ_objective_${PHASEJ_OBJECTIVE_ARM}_${PHASEJ_OBJECTIVE_TRAIN_JOB}"
GATE="phaseJ/gates/phaseJ_objective_${PHASEJ_OBJECTIVE_ARM}_${PHASEJ_OBJECTIVE_TRAIN_JOB}_${JOB}"
ROOT="phaseJ/official/phaseJ_objective_${PHASEJ_OBJECTIVE_ARM}_${PHASEJ_OBJECTIVE_TRAIN_JOB}_${JOB}"

test -s "$AUDIT/conditioning_audit.json"
python phaseJ/objective_gate.py \
  --audit "$AUDIT/conditioning_audit.json" \
  --output_dir "$GATE" \
  --arm "$PHASEJ_OBJECTIVE_ARM" \
  --wandb_project sd-mmdit-ranker-v1 \
  --wandb_group "$PHASEJ_GROUP" \
  --wandb_run_name "phaseJ_objective_${PHASEJ_OBJECTIVE_ARM}_gate_${JOB}"

if ! jq -e '.pass == true' "$GATE/decision.json" >/dev/null; then
  echo "Cached prompt gate failed; official CompBench was pre-registered to stop."
  exit 0
fi

if [[ -e "$ROOT" ]]; then
  echo "Refusing to overwrite $ROOT" >&2
  exit 2
fi
mkdir -p "$ROOT/scores"

for MODE in correct shuffled; do
  if [[ "$MODE" == correct ]]; then
    SOURCE_LABEL=mmdit_fusion_correct
    SCORE_LABEL=mmdit_fusion
  else
    SOURCE_LABEL=mmdit_fusion_shuffled
    SCORE_LABEL=mmdit_fusion_shuffled
  fi
  for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
    D="$ROOT/scores/${SCORE_LABEL}_s4_${CAT}"
    python phaseC/compbench_eval.py stage \
      --images "$AUDIT/$MODE/selection/images/$SOURCE_LABEL" \
      --prompts "$AUDIT/$MODE/selection/prompts.json" \
      --steps 4 --categories "$CAT" --out "$D"
    python phaseC/compbench_eval.py run --dir "$D" --skip_done
    python phaseC/compbench_eval.py collect --dir "$D" --routing_split val
  done
done

for CAT in color shape texture spatial 3d_spatial numeracy non_spatial complex; do
  ln -s "$(realpath "phaseH/scores/random_s4_${CAT}")" \
    "$ROOT/scores/random_s4_${CAT}"
  ln -s "$(realpath "phaseH/scores/oracle_s4_${CAT}")" \
    "$ROOT/scores/oracle_s4_${CAT}"
done

python phaseC/eval_analyze.py \
  --scores_dir "$ROOT/scores" --step 4 \
  --models mmdit_fusion,mmdit_fusion_shuffled \
  --title "Same BT-plus-text checkpoint: correct versus shuffled scoring prompt" \
  --geneval2_dir "$ROOT/not_run" \
  --fidelity "$ROOT/not_run.json" \
  --diversity "$ROOT/not_run.json" \
  --out "$ROOT/correct_vs_shuffled.md"

python phaseC/eval_analyze.py \
  --scores_dir "$ROOT/scores" --step 4 \
  --models mmdit_fusion,random,oracle \
  --title "BT-plus-text fusion ranker versus random selection" \
  --geneval2_dir "$ROOT/not_run" \
  --fidelity "$ROOT/not_run.json" \
  --diversity "$ROOT/not_run.json" \
  --out "$ROOT/official_vs_random.md"

python phaseJ/log_prompt_compare_wandb.py \
  --root "$ROOT" \
  --correct_run "$AUDIT/correct" \
  --shuffled_run "$AUDIT/shuffled" \
  --project sd-mmdit-ranker-v1 \
  --group "$PHASEJ_GROUP" \
  --run_name "phaseJ_objective_${PHASEJ_OBJECTIVE_ARM}_official_prompt_${JOB}"

python phaseJ/log_counterfactual_official_wandb.py \
  --root "$ROOT" \
  --model_label mmdit_fusion \
  --project sd-mmdit-ranker-v1 \
  --group "$PHASEJ_GROUP" \
  --run_name "phaseJ_objective_${PHASEJ_OBJECTIVE_ARM}_official_random_${JOB}"

echo "[$(date --iso-8601=seconds)] official evaluation complete: $ROOT"
